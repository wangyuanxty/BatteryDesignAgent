1000（≈1 kg 基准电芯）导致小电芯 dT/dt 被系统性低估。 100	    """ 101	    if mass_kg is not None: 102	        mcp_j_k = mass_kg * 900.0 103	    y0 = np.asarray([t_init_k, x_sei_init, 0.0, 1.0]) 104	    sol = solve_ivp( 105	        _rhs, 106	        (0.0, t_max_s), 107	        y0, 108	        method="BDF", 109	        rtol=1e-7, 110	        atol=1e-9, 111	        max_step=0.2,  # 反应耗尽发生在 ms~0.1s 量级，步长上限必须小于该量级 112	        args=(mcp_j_k, hA_w_k, t_amb_k, q_nail_w), 113	        dense_output=True, 114	    ) 115	    t_grid = np.linspace(0.0, t_max_s, 2001) 116	    y_grid = sol.sol(t_grid) 117	    t_k = y_grid[0] 118	    dtdt = np.gradient(t_k, t_grid) 119	    trigger_idx = int(np.argmax(dtdt > TRIGGER_DTDT)) if np.any(dtdt > TRIGGER_DTDT) else -1 120	    if trigger_idx < 0 and np.any(t_k >= TRIGGER_T_K): 121	        trigger_idx = int(np.argmax(t_k >= TRIGGER_T_K)) 122	    triggered = trigger_idx >= 0 123	    return { 124	        "triggered": bool(triggered), 125	        "trigger_time_s": float(t_grid[trigger_idx]) if triggered else None, 126	        "T_max_K": float(t_k.max()), 127	        "T_final_K": float(t_k[-1]), 128	        "dTdt_max_K_s": float(dtdt.max()), 129	        "T_series_K": [round(float(v), 2) for v in t_k[::20]], 130	        "t_series_s": [round(float(v), 2) for v in t_grid[::20]], 131	        "params": { 132	            "t_init_K": t_init_k, 133	            "mcp_J_K": mcp_j_k, 134	            "hA_W_K": hA_w_k, 135	            "t_amb_K": t_amb_k, 136	            "q_nail_W": q_nail_w, 137	            "source": "Kim et al. 2019 / Coman et al. 2016 Arrhenius 三副反应，零维集总热平衡", 138	        }, 139	    } 140	 141	 142	def cmd_run_thermal_runaway(args) -> int: 143	    try: 144	        t_init_k = args.t_init 145	        if args.sim: 146	            # 过充/放电仿真输出耦合：读取其 T_max_K 作为热失控初始温度（自动串联） 147	            sim = json.loads(Path(args.sim).read_text(encoding="utf-8-sig")) 148	            if "T_max_K" not in sim: 149	                raise ValueError(f"--sim 文件缺少 T_max_K 键（应传 run-pyamm 输出