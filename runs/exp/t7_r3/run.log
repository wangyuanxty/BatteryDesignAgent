6	 67	def _cell_volume_default(parameter_values: pybamm.ParameterValues) -> float | None: 68	    """Mechanical cell volume proxy for sets lacking "Cell volume [m3]": 69	    electrode height x width x (positive + separator + negative layer thickness). 70	    Returns None when any geometric parameter is missing.""" 71	    names = ( 72	        "Electrode height [m]", 73	        "Electrode width [m]", 74	        "Positive electrode thickness [m]", 75	        "Separator thickness [m]", 76	        "Negative electrode thickness [m]", 77	    ) 78	    try: 79	        height, width, l_pos, l_sep, l_neg = (float(parameter_values[n]) for n in names) 80	    except Exception: 81	        return None 82	    return height * width * (l_pos + l_sep + l_neg) 83	 84	 85	def _run_aging(parameter_values: pybamm.ParameterValues, p: dict, mode: str) -> dict: 86	    """老化协议：N 圈 1C 恒流充放（SEI ec reaction limited + isothermal）。 87	 88	    输出 cycle_numbers / capacity_ah_per_cycle / sei_thickness_nm_end。 89	    基参数集无 SEI 动力学参数时报错（老化必须用老化体系，如 Chen2020/OKane2022）。 90	    """ 91	    sei_required = "SEI kinetic rate constant [m.s-1]" 92	    if sei_required not in parameter_values: 93	        raise ValueError( 94	            f"base parameter set has no '{sei_required}'; the aging protocol requires " 95	            "an aging-capable parameter set (e.g. Chen2020, OKane2022)" 96	        ) 97	    v_min = float(parameter_values["Lower voltage cut-off [V]"]) 98	    v_max = float(parameter_values["Upper voltage cut-off [V]"]) 99	    exp = pybamm.Experiment( 100	        [( 101	            f"Discharge at {p['C_rate']:g}C until {v_min} V", 102	            f"Charge at {p['C_rate']:g}C until {v_max} V", 103	        )] * p["cycles"] 104	    ) 105	    options = {"SEI": "ec reaction limited", "thermal": "isothermal"} 106	    model = ( 107	        pybamm.lithium_ion.DFN(options=options) 108	        if mode == "dfn" 109	        else pybamm.lithium_ion.SPMe(options=options) 110	    ) 111	    sol = pybamm.Simulation(mode