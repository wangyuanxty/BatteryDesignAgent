[tool_result]1	"""calc-energy：合同口径能量密度计算（所有任务共用同一公式，杜绝跨任务抄先例）。 2	 3	ED = ∫V·I_1C dt / Σ(层厚×(1−孔隙率)×密度×面积) 4	- I_1C = Nominal cell capacity × 1（恒流） 5	- 面积 = Electrode height × width 6	- 层：正/负极活性层（含孔隙）、正/负集流体（无孔隙因子）、隔膜 7	- 电解液不计入质量（参数集缺密度，如实标注） 8	""" 9	import json 10	from pathlib import Path 11	 12	import numpy as np 13	import pybamm 14	 15	 16	def _layer(th: float, por: float, den: float) -> float: 17	    return th * (1 - por) * den  # kg/m² 18	 19	 20	def calc_energy(params_json: str, discharge_json: str, base: str) -> dict: 21	    if base.endswith(".json"): 22	        # 自定义参数集（高电压 LNMO 等）：Chen2020 基底 + JSON 覆盖键（OCP 符号函数手动绑定） 23	        import json as _json 24	        from pathlib import Path as _Path 25	 26	        from bda.simulators.lnmo_parameters import lnmo_ocp 27	 28	        extra = _json.loads(_Path(base).read_text(encoding="utf-8")) 29	        for key in ("Positive electrode OCP [V]", "Positive electrode OCP [V] (from stoich)"): 30	            if isinstance(extra.get(key), str): 31	                extra[key] = lnmo_ocp 32	        pv = pybamm.ParameterValues("Chen2020") 33	        pv.update(extra, check_already_exists=False) 34	    else: 35	        pv = pybamm.ParameterValues(base) 36	    if params_json: 37	        ov = json.loads(Path(params_json).read_text(encoding="utf-8-sig")) 38	        pv.update(ov) 39	    area = float(pv["Electrode height [m]"]) * float(pv["Electrode width [m]"]) 40	    i_1c = float(pv["Nominal cell capacity [A.h]"]) * 1.0 41	    dis = json.loads(Path(discharge_json).read_text(encoding="utf-8-sig")) 42	    v = np.asarray(dis["voltage_v"]) 43	    t = np.asarray(dis["time_s"]) 44	    # 兼容 numpy 2（np.trapezoid）与 1.x（np.trapz 旧名） 45	    _trapz = getattr(np, "trapezoid", np.trapz) 46	    energy_wh = float(_trapz(v * i_1c, t) / 3600.0) 47	    pos_el = _layer( 48	        float(pv["Positive electrode thickness [m]"]), 49	        float(pv["Positive electrode porosity"]), 50	        float(pv["Positive electrode density [kg.m-3]"]), 51	    ) 52	    neg_el = _layer( 53	        float(pv["Negative electrode thickness [m]"]), 54	        float(pv["Negative electrode porosity"]), 55	        float(pv["Negative electrode density [kg.m-3]"]), 56	    ) 57	    pos_cc = float(pv["Positive current collector thickness [m]"]) * float( 58	        pv["Positive current collector density [kg.m-3]"] 59	    ) 60	    neg_cc = float(pv["Negative current collector thickness [m]"]) * float( 61	        pv["Negative current collector density [kg.m-3]"] 62	    ) 63	    sep = _layer( 64	        float(pv["Separator thickness [m]"]), 65	        float(pv["Separator porosity"]), 66	        float(pv["Separator density [kg.m-3]"]), 67	    ) 68	    mass_kg = (pos_el + neg_el + pos_cc + neg_cc + sep) * area 69	    # 体积（合同口径：Σ层厚×面积，含孔隙；与质量同层集——电极/隔膜/集流体，不含电解液） 70	    thickness_m = ( 71	        float(pv["Positive electrode thickness [m]"]) 72	        + float(pv["Negative electrode thickness [m]"]) 73	        + float(pv["Separator thickness [m]"]) 74	        + float(pv["Positive current collector thickness [m]"]) 75	        + float(pv["Negative current collector thickness [m]"]) 76	    ) 77	    volume_m3 = thickness_m * area 78	    volume_l = volume_m3 * 1000.0  # 1 m³ = 1000 L 79	    # 电压平台（机械推导）：放电时间中点处的电压（恒流放电，时间中点 ≈ 容量中点） 80	    mid_idx = int(len(t) * 0.5) 81	    midpoint_voltage_v = float(v[mid_idx]) 82	    # 直流内阻（机械推导）：放电起始 OCV 与 10% 放电时间处电压差 / I_1C（恒流） 83	    idx = max(1, int(len(t) * 0.1)) 84	    dcr_ohm = (v[0] - v[idx]) / i_1c 85	    # 功率密度（理论峰值近似）：P_max = V_OC²/(4·R_DC)，按质量归一 86	    power_density_w_kg = (v[0] ** 2) / (4.0 * dcr_ohm) / mass_kg if dcr_ohm > 0 else float("nan") 87	    return { 88	        "capacity_ah": dis["capacity_ah"], 89	        "energy_wh": energy_wh, 90	        "mass_kg": mass_kg, 91	        "energy_density_wh_kg": energy_wh / mass_kg, 92	        "volume_m3": volume_m3, 93	        "energy_density_wh_l": energy_wh / volume_l, 94	        "thickness_m": thickness_m, 95	        "midpoint_voltage_v": midpoint_voltage_v,