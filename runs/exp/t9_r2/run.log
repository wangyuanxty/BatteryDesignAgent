 ("P", (0.45782, 0.39759, 0.35181)), 244	    ("P", (0.75192, 0.38467, 0.14738)), 245	    ("O", (0.0267, 0.1788, 0.09643)), 246	    ("O", (0.0361, 0.3649, 0.42742)), 247	    ("O", (0.0850, 0.0021, 0.28038)), 248	    ("O", (0.1152, 0.6330, 0.06577)), 249	    ("O", (0.1785, 0.7151, 0.31962)), 250	    ("O", (0.2392, 0.3319, 0.07040)), 251	    ("O", (0.2789, 0.3861, 0.35185)), 252	    ("O", (0.3675, 0.5514, 0.54043)), 253	    ("O", (0.4764, 0.2357, 0.31413)), 254	    ("O", (0.5906, 0.0200, 0.23807)), 255	    ("O", (0.5994, 0.4098, 0.16881)), 256	    ("O", (0.6748, 0.4125, 0.02723)), 257	) 258	 259	_TM_EXCLUDED = ("Li", "O", "P", "S", "F") 260	 261	 262	def _substitute_tm( 263	    struct: Structure, tm_sites: list[int], formula: str 264	) -> tuple[Structure, dict[str, int], list[int]]: 265	    """Assign all TM sites on the prototype by formula fractions (normalized) via the 266	    largest-remainder method.""" 267	    tm = { 268	        str(k): float(v) 269	        for k, v in Composition(formula).items() 270	        if str(k) not in _TM_EXCLUDED 271	    } 272	    if not tm or any(v <= 0 for v in tm.values()): 273	        raise ValueError(f"no transition-metal species in formula: {formula}") 274	    total = sum(tm.values()) 275	    counts = _largest_remainder({k: v / total for k, v in tm.items()}, len(tm_sites)) 276	    rng = np.random.default_rng(_seed(formula)) 277	    order = rng.permutation(len(tm_sites)) 278	    assignment: list[str] = [] 279	    for sym, k in counts.items(): 280	        assignment += [sym] * k 281	    rng.shuffle(assignment) 282	    for pos, sym in zip(order, assignment): 283	        struct.replace(tm_sites[pos], sym) 284	    return struct, counts, tm_sites 285	 286	 287	def _build_tavorite(formula: str, *, sulfate: bool) -> tuple[Structure, dict[str, int], list[int]]: 288	    """Tavorite-type LiM(XO4)F (X=P phosphate / X=S sulfate), triclinic P-1, Z=2. 289	 290	    Cell and coordinate provenance: 291	    - Phosphate family (X=P): LiVPO4F, a=5.184 b=5.312 c=7.266 Å, α=107.58 β=107.95 γ=98.45° 292	      with the asymmetric-unit coordinates (V 1a/1b inversion centers; P/F/O×4/Li each 2i) 293	      taken from LiVPO4F powder neutron/synchrotron refinement (OSTI; cf. the same family in 294	      ICSD 184601: a=5.1708 b=5.3083 c=7.2631 Å — consistent across reports). 295	    - Sulfate family (X=S): LiFeSO4F, a=5.1747 b=5.4943 c=7.2224 Å, 296	      α=106.522 β=107.210 γ=97.791° (Barpanda et al., Nat. Mater. 2011, supplementary). 297	      This family shares the tavorite topology with the phosphate family, so the framework 298	      fractional coordinates above are reused with S on the X site and the sulfate cell; 299	      **that approximation is validated by a literature voltage anchor**: the computed 300	      LiFeSO4F value must land near the literature ~3.6 V, otherwise this family is excluded 301	      honestly. 302	    2×2×1 supercell → 64 atoms / 8 Li / 8 TM. 303	    """ 304	    if sulfate: 305	        lat = Lattice.from_parameters(5.1747, 5.4943, 7.2224, 106.522, 107.210, 97.791) 306	        x_species = "S" 307	    else: 308	        lat = Lattice.from_parameters(5.184, 5.312, 7.266, 107.58, 107.95, 98.45) 309	        x_species = "P" 310	    species = [x_species if sym == "X" else sym for sym, _ in _TAVORITE_SITES] 311	    coords = [list(xyz) for _, xyz in _TAVORITE_SITES] 312	    struct = Structure.from_spacegroup("P-1", lat, species, coords) 313	    struct.make_supercell((2, 2, 1)) 314	    tm_sites = [i for i, site in enumerate(struct) if site.specie.symbol == "M"] 315	    return _substitute_tm(struct, tm_sites, formula) 316	 317	 318	def _build_nasicon(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 319	    """NASICON-type Li3M2(PO4)3, monoclinic P2₁/c. 320	 321	    Cell and the 20 asymmetric-unit sites from: Li3V2(PO4)3, a=8.6201 b=8.6013 c=14.7465 Å, 322	    β=125.204°, Crystallography Open Database entry COD 2237423 (from_spacegroup generates the 323	    80-atom cell = 12 Li / 8 TM / 12 P /