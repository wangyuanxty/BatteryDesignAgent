{"file_path": "D:\\research\\degradation_prognostics\\Battery_Design_Agent\\runs\\exp\\t2_r1_singlemodel\\cell\\probe_p1_state.py", "content": "\"\"\"Diagnostic: dump SPMe internal state at the end of the P1 1C discharge.\"\"\"\nimport pybamm\nimport numpy as np\n\npv = pybamm.ParameterValues(\"Chen2020\")\npv.update({\n    \"Negative electrode thickness [m]\": 2.5e-4,\n    \"Positive electrode thickness [m]\": 1.0e-4,\n    \"Positive particle radius [m]\": 3.0e-6,\n    \"Negative particle radius [m]\": 3.5e-6,\n})\nv_min = float(pv[\"Lower voltage cut-off [V]\"])\nv_max = float(pv[\"Upper voltage cut-off [V]\"])\nexp = pybamm.Experiment([f\"Discharge at 1C until {v_min} V\"])\nmodel = pybamm.lithium_ion.SPMe()\nsim = pybamm.Simulation(model, experiment=exp, parameter_values=pv)\nsol = sim.solve()\n\nT = sol[\"Time [s]\"].entries\n# find the point where V crosses ~3.6 (start of cliff) and the final point\nV = sol[\"Terminal voltage [V]\"].entries\ni_cliff = int(np.argmax(V < 3.6))\nprint(f\"cliff starts t={T[i_cliff]:.1f}s V={V[i_cliff]:.3f} ; end t={T[-1]:.1f}s V={V[-1]:.3f}\")\nprint(f\"capacity at cliff = {T[i_cliff]*5/3600:.4f} Ah ; at end = {T[-1]*5/3600:.4f} Ah\")\n\ndef g(name):\n    a = sol[name].entries\n    return a[i_cliff], a[-1]\n\nfor name in [\n    \"Negative electrode surface potential difference at separator interface [V]\",\n    \"X-averaged negative particle concentration [mol.m-3]\",\n    \"Negative particle surface concentration [mol.m-3]\",\n    \"X-averaged positive particle concentration [mol.m-3]\",\n    \"Positive particle surface concentration [mol.m-3]\",\n    \"X-averaged negative electrode open-circuit potential [V]\",\n    \"Negative electrode surface open-circuit potential [V]\",\n    \"X-averaged positive electrode open-circuit potential [V]\",\n    \"Positive electrode surface open-circuit potential [V]\",\n    \"Negative electrode reaction overpotential [V]\",\n    \"Positive electrode reaction overpotential [V]\",\n    \"X-averaged electrolyte concentration [mol.m-3]\",\n    \"Electrolyte potential [V]\",\n]:\n    try:\n        c, e = g(name)\n        print(f\"{name}: at_cliff={c:.4f} at_end={e:.4f}\")\n    except Exception as ex:\n        print(f\"{name}: unavailable ({type(ex).__name__})\")\n\nc_max_n = float(pv[\"Maximum concentration in negative electrode [mol.m-3]\"])\nc_max_p = float(pv[\"Maximum concentration in positive electrode [mol.m-3]\"])\nfor name in [\"Negative particle surface concentration [mol.m-3]\",\n             \"Positive particle surface concentration [mol.m-3]\"]:\n    c, e = g(name)\n    cmax = c_max_n if \"Negative\" in name else c_max_p\n    print(f\"{name} [stoich]: at_cliff={c/cmax:.4f} at_end={e/cmax:.4f}\")\n"}
