 96	        "dcr_ohm": dcr_ohm, 97	        "power_density_w_kg": power_density_w_kg, 98	        "layer_kg_m2": { 99	            "positive_electrode": pos_el, 100	            "negative_electrode": neg_el, 101	            "positive_cc": pos_cc, 102	            "negative_cc": neg_cc, 103	            "separator": sep, 104	        }, 105	        "area_m2": area, 106	        "electrolyte_included": False, 107	        "note": "电解液不计入质量与体积（参数集缺密度）", 108	    } 109	 110	 111	def cmd_calc_energy(args) -> int: 112	    import sys 113	 114	    try: 115	        out = calc_energy(args.params, args.sim, args.base) 116	    except (ValueError, KeyError, json.JSONDecodeError) as e: 117	        print(f"bda error: {e}", file=sys.stderr) 118	        return 1 119	    with open(args.out, "w", encoding="utf-8") as f: 120	        json.dump(out, f, ensure_ascii=False, indent=2) 121	    return 0 122
