    },
    {
      "id": "2605.30281",
      "versioned_id": "2605.30281v1",
      "title": "Characterization of Spurious Charge in SENSEI Skipper-CCDs",
      "authors": [
        "Yikai Wu",
        "Ansh Desai",
        "Sho Uemura",
        "Ana M. Botti",
        "Brenda A. Cervantes-Vergara",
        "Fernando Chierchie",
        "Alex Drlica-Wagner",
        "Rouven Essig",
