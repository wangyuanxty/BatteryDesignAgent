r")) 225	        return 1 226	    log.info("tokens: %s", _usage_summary(result)) 227	    log.info("result:\n%s", result.result or "") 228	    return 0 229	 230	 231	def main(argv: list[str] | None = None) -> int: 232	    _disable_auto_memory() 233	    parser = argparse.ArgumentParser( 234	        prog="run.py", 235	        description="Headless Claude Code session (this repo, project settings, bypassPermissions)", 236	    ) 237	    parser.add_argument("prompt", nargs="?", help="Task description, e.g.: python run.py \"design a battery with 20%% higher energy density...\"") 238	    parser.add_argument("--max-turns", type=int, default=300, help="Maximum conversation turns (default 1000)") 239	    parser.add_argument("--workspace", default=None, help="Workspace directory (artifact destination); unset = agent decides") 240	    parser.add_argument("--model", default=os.environ.get("ANTHROPIC_MODEL") or "", help="Model override (robustness experiments, e.g. deepseek-v4-pro; default = ANTHROPIC_MODEL or session default)") 241	    parser.add_argument( 242	        "--override", 243	        default=None, 244	        help="system prompt override (ablation B, e.g. 'architecture variant count not enforced') — system-level instruction, overrides skill rules", 245	    ) 246	    args = parser.parse_args(argv) 247	    if not args.prompt: 248	        parser.error('Task description required, e.g.: python run.py "design a battery with 20% higher energy density..."') 249	    if args.max_turns is not None and args.max_turns <= 0: 250	        parser.error("--max-turns must be a positive integer") 251	    ws = Path(args.workspace).resolve() if args.workspace else None 252	    prompt = f"headless session: no user present, skip clarification questions (SKILL.md zero-interaction rule), parse parameters from the task text, use defaults for unspecified ones, write to log.jsonl entry 0.\nTask: {args.prompt}" 253	    if ws: 254	        prompt = f"Workspace: {ws}\n" + prompt 255	    system = f"You 