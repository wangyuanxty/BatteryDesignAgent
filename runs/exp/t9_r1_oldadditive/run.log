    neg_el = _layer( 53	        float(pv["Negative electrode thickness [m]"]), 54	        float(pv["Negative electrode porosity"]), 55	        float(pv["Negative electrode density [kg.m-3]"]), 56	    ) 57	    pos_cc = float(pv["Positive current collector thickness [m]"]) * float( 58	        pv["Positive current collector density [kg.m-3]"] 59	    ) 60	    neg_cc = float(pv["Negative current collector thickness [m]"]) * float( 61	        pv["Negative current collector density [kg.m-3]"] 62	    ) 63	    sep = _layer( 64	        float(pv["Separator thickness [m]"]), 65	        float(pv["Separator porosity"]), 66	        float(pv["Separator density [kg.m-3]"]), 67	    ) 68	    mass_kg = (pos_el + neg_el + pos_cc + neg_cc + sep) * area 69	    # 体积（合同口径：Σ层厚×面积，含孔隙；与质量同层集——电极/隔膜/集流体，不含电解液） 70	    thickness_m = ( 71	        float(pv["Positive electrode thickness [m]"]) 72	        + float(pv["Negative electrode thickness [m]"]) 73	        + float(pv["Separator thickness [m]"]) 74	        + float(pv["Positive current collector thickness [m]"]) 75	        + float(pv["Negative current collector thickness [m]"]) 76	    ) 77	    volume_m3 = thickness_m * area 78	    volume_l = volume_m3 * 1000.0  # 1 m³ = 1000 L 79	    # 电压平台（机械推导）：放电时间中点处的电压（恒流放电，时间中点 ≈ 容量中点） 80	    mid_idx = int(len(t) * 0.5) 81	    midpoint_voltage_v = float(v[mid_idx]) 82	    # 直流内阻（机械推导）：放电起始 OCV 与 10% 放电时间处电压差 / I_1C（恒流） 83	    idx = max(1, int(len(t) * 0.1)) 84	    dcr_ohm = (v[0] - v[idx]) / i_1c 85	    # 功率密度（理论峰值近似）：P_max = V_OC²/(4·R_DC)，按质量归一 86	    power_density_w_kg = (v[0] ** 2) / (4.0 * dcr_ohm) / mass_kg if dcr_ohm > 0 else float("nan") 87	    return { 88	        "capacity_ah": dis["capacity_ah"], 89	        "energy_wh": energy_wh, 90	        "mass_kg": mass_kg, 91	        "energy_density_wh_kg": energy_wh / mass_kg, 92	        "volume_m3": volume_m3, 93	        "energy_density_wh_l": energy_wh / volume_l, 94	        "thickness_m": thickness_m, 95	        "midpoint_voltage_v": midpoint_voltage_v, 96	        "dcr_ohm": dcr_ohm, 97	        "power_density_w_kg": power_density_w_kg, 98	        "layer_kg_m2": { 99	            "positive_electrode": pos_el, 100	            "negative_electrode": neg_el, 101	            "positive_cc": pos_cc, 102	            "negative_cc": neg_cc, 103	            "separator": sep, 104	        }, 105	        "area_m2": area, 106	        "electrolyte_included": False, 107	        "note": "电解液不计入质量与体积（参数集缺密度）", 108	    } 109	 110	 111	def cmd_calc_energy(args) -> int: 112	    import sys 113	 114	    try: 115	        out = calc_energy(args.params, args.sim, args.base) 116	    except (ValueError, KeyError, json.JSONDecodeError) as e: 117	        print(f"bda error: {e}", file=sys.stderr) 118	        return 1 119	    with open(args.out, "w", encoding="utf-8") as f: 120	        json.dump(out, f, ensure_ascii=False, indent=2) 121	    return 0 122
