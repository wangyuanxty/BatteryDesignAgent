72	 73	 74	def _variant_dict(c) -> dict: 75	    """struct/params → dict (params may be a JSON string; parse it).""" 76	    v = c.get("struct") or c.get("params") 77	    if isinstance(v, str): 78	        try: 79	            v = json.loads(v) 80	        except (json.JSONDecodeError, TypeError): 81	            return {} 82	    return v if isinstance(v, dict) else {} 83	 84	 85	def _cand_type(c) -> str: 86	    """CandidateType (mechanical): smiles=molecule; base only=system; 87	    struct/params variants: electrolyte keys=formulation, else structure.""" 88	    if not isinstance(c, dict): 89	        return "Molecule" 90	    if c.get("smiles"): 91	        return "Molecule" 92	    variant = _variant_dict(c) 93	    if variant: 94	        if any("electrolyte" in str(k).lower() or "transference" in str(k).lower() for k in variant): 95	            return "Formulation" 96	        return "Structure" 97	    if c.get("base"): 98	        return "System" 99	    return "Molecule" 100	 101	 102	def _cand_content(c) -> str: 103	    if not isinstance(c, dict): 104	        return str(c) 105	    if c.get("smiles"): 106	        return str(c["smiles"]) 107	    if c.get("base"): 108	        return str(c["base"]) 109	    variant = _variant_dict(c) 110	    if variant: 111	        return "; ".join(f"{k} = {_fmt_num(v)}" for k, v in variant.items()) 112	    return "" 113	 114	 115	def _source_chip(c) -> str: 116	    source = str(c.get("source") or "") if isinstance(c, dict) else "" 117	    cls = "seed" if source.lower() == "seed" else "free" if source.lower() in ("free_gen", "free") else "" 118	    return f'<span class="chip tag {cls}">{_html_escape(source.upper())}</span>' if source and cls else "" 119	 120	 121	def _cand_component(c) -> str: 122	    """CandidateComponent (mechanical): molecule/formulation→Electrolyte; 123	    system→Cell system; struct/params keys→component.""" 124	    t = _cand_type(c) 125	    if t in ("Molecule", "Formulation"): 126	        return "Electrolyte" 127	    if t == "System": 128	        return "Cell system" 129	    struct = _variant_dict(c) if isinstance(c, dict) else {} 130	    comps = [] 131	    for k in struct: 132	        ks = str(k) 133	        if "Separator" in ks: 134	            comps.append("Separator") 135	        elif "collector" in ks: 136	            comps.append("Current collector") 137	        elif "Electrolyte" in ks: 138	            comps.append("Electrolyte") 139	        elif "Positive electrode" in ks: 140	            comps.append("Cathode") 141	        elif "Negative electrode" in ks: 142	            comps.append("Anode") 143	    if not comps: 144	        return "Structure" 145	    return " + ".join(dict.fromkeys(comps))  # dedupe, keep order 146	 147	 148	def _cand_row(c) -> str: 149	    """Candidate table row: candidate (name+source) | component | type | role | content.""" 150	    if isinstance(c, dict): 151	        name = str(c.get("name") or "") 152	        role = str(c.get("role") or "") 153	        content = _cand_content(c) 154	        src = _source_chip(c) 155	    else: 156	        name, role, content, src = "", "", str(c), "" 157	    head = f"<b>{_html_escape(name)}</b>{src}" if name else f'<span class="sm">{_html_escape(content)}</span>' 158	    return ( 159	        f"<tr><td>{head}</td><td>{_html_escape(_cand_component(c))}</td>" 160	        f"<td>{_html_escape(_cand_type(c))}</td><td>{_html_escape(role)}</td>" 161	        f"<td class='mono'>{_html_escape(content)}</td></tr>" 162	    ) 163	 164	 165	_CAND_HEAD = "<tr><th>Candidate</th><th>Component</th><th>Type</th><th>Role</th><th>Content</th></tr>" 166	 167	 168	def _read_goal(case_dir: str) -> str | None: 169	    """从 config.yaml 读取设计目标（缺失/损坏时返回 None，如实标注）。""" 170	    p = Path(case_dir) / "config.yaml" 171	    if not p.exists(): 172	        return None 173	    try: 174	        import yaml 175	 176	        data = yaml.safe_load(p.read_text(encoding="utf-8")) 177	        goal = data.get("goal") if isinstance(data, dict) else None 178	        return str(goal) if goal else None 179	    except Exception: 180	        return None 181	 182	 183	def _verdict_class(verdict: str) -> str: 184	    v = str(verdict).strip().lower() 185	    if not v: 186	        return "neutral" 187	    if "不达标" in v or v in ("fail", "failed", "reject", "rejected", "no"): 188	        return "bad" 189	    if "达标" in v or v in ("pass", "passed", "ok", "yes"): 190	        return "ok" 191	    return "neutral" 192	 193	 194	def _verdict_badge(verdict: str) -> str: 195	    cls = _verdict_class(verdict) 196	    return f'<span class="badge {cls}">{_html_escape(str(verdict))}</span>' 197	 198	 199	# 五阶段流程（1=规划，2–4=漏斗阶段，5=True DFT/MD endorsement；阶段编号与 SKILL.md 流程一致。 200	# 阶段 5 沿用 .badge.stage.end 铜色样式区分。） 201	_STAGE_LABELS = {1: "STAGE 1 Plan", 2: "STAGE 2 Materials", 3: "STAGE 3 Cell", 4: "STAGE 4 Safety", 5: "STAGE 5 True DFT/MD"} 202	 203	 204	def _stage_badge(stage: int | None) -> str: 205	    """STAGE 小标（blueprint 风格：等宽 10.5px 边框徽章，沿用 .badge + --blue/--accent）。""" 206	    if stage not in _STAGE_LABELS: 207	        return "" 208	    cls = "badge stage end" if stage == 5 else "badge stage" 209	    return f'<span class="{cls}">{_STAGE_LABELS[stage]}</span>' 210	 211	 212	def _stage_range_badge(lo: int, hi: int) -> str: 213	    """轮卡片阶段范围徽章：单阶段沿用 _stage_badge；跨阶段显示 STAGE N–M（en dash）。 214	    范围仅由数字阶段（1–5）构成，阶段 5（True DFT/MD endorsement）可参与范围（如 STAGE 4–5）； 215	    endorse/final 条目不进轮卡片，阶段 5 在Flow overview条中单独显示。""" 216	    if lo == hi: 217	        return _stage_badge(lo) 218	    if lo not in _STAGE_LABELS or hi not in _STAGE_LABELS: 219	        return "" 220	    return f'<span class="badge stage">STAGE {lo}–{hi}</span>' 221	 222	 223	def _entry_stage(e: dict) -> int | None: 224	    """log 条目 → 流程阶段：plan=1（总体设计规划）；mol. propose/funnel=2（材料）； 225	    struct propose=3（电芯）；evaluate 按内容推断（安全Metric=4，结构=3，否则=2）； 226	    endorse/final=5（True DFT/MD endorsement）。""" 227	    action = e.get("action") 228	    if action == "plan": 229	        return 1 230