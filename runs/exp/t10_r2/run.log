d( 65	        { 66	            "check": "7 类交付物齐全（源文件 + PDF）", 67	            "pass": not missing, 68	            "detail": "; ".join(missing) if missing else "7 类全部齐备", 69	        } 70	    ) 71	 72	    # 2. PDF 非空 73	    empty_pdfs = [] 74	    for key in REQUIRED: 75	        for p in _iter_files(case_dir)[key]: 76	            if p.suffix == ".pdf" and p.stat().st_size < 1024: 77	                empty_pdfs.append(p.name) 78	    checks.append( 79	        { 80	            "check": "PDF 非空（>1KB）", 81	            "pass": not empty_pdfs, 82	            "detail": "; ".join(empty_pdfs) if empty_pdfs else "全部 PDF 非空", 83	        } 84	    ) 85	 86	    # 3. xlsx 可解析且无空 sheet 87	    bad_xlsx = [] 88	    for key in REQUIRED: 89	        for p in _iter_files(case_dir)[key]: 90	            if p.suffix != ".xlsx": 91	                continue 92	            try: 93	                wb = openpyxl.load_workbook(p, read_only=True) 94	                empty_sheets = [ws.title for ws in wb.worksheets if ws.max_row == 0] 95	                if empty_sheets: 96	                    bad_xlsx.append(f"{p.name}: 空 sheet {empty_sheets}") 97	            except Exception as e: 98	                bad_xlsx.append(f"{p.name}: 无法解析 ({e})") 99	    checks.append( 100	        { 101	            "check": "xlsx 可解析且无空 sheet", 102	            "pass": not bad_xlsx, 103	            "detail": "; ".join(bad_xlsx) if bad_xlsx else "xlsx 全部正常", 104	        } 105	    ) 106	 107	    # 4. delivery_index 内容含 VBF 编号清单（协议编号在索引里，不在文件名） 108	    idx = _iter_files(case_dir)["delivery_index"] 109	    idx_text = "" 110	    for p in idx: 111	        if p.suffix in (".md", ".txt"): 112	            idx_text = p.read_text(encoding="utf-8-sig", errors="replace") 113	            break 114	    id_matches = re.findall(r"VBF-[A-Z0-9]+-(DS|BOM|DSH|CALC|DVPR|DFMEA|IDX)-\d+", idx_text) 115	    checks.append( 116	        { 117	            "check": "delivery_index 含 VBF 编号清单", 118	            "pass": len(id_matches) >= 5, 119	            "detail": f"找到 {len(id_matches)} 个编号" if id_matches else "索引中无 VBF 编号", 120	        } 121	    ) 122	 123	    # 5. 审计链完整性：每个 propose 轮必须有同 round 的 evaluate 条目 124	    #    （评估发生却不落日志 → 报告中的结论无审计背书，v3 的 V1-V3 事故） 125	    log_entries = [] 126	    log_path = case_dir / "log.jsonl" 127	    if log_path.exists(): 128	        for line in log_path.read_text(encoding="utf-8-sig").splitlines(): 129	            line = line.strip() 130	            if not line: 131	                continue 132	            try: 133	                log_entries.append(json.loads(line)) 134	            except json.JSONDecodeError: 135	                continue 136	    prop_rounds = { 137	        e.get("round") 138	        for e in log_entries 139	        if e.get("action") == "propose" and isinstance(e.get("round"), int) and e.get("round") > 0 140	    } 141	    ev_rounds = { 142	        e.get("round") 143	        for e in log_entries 144	        if e.get("action") == "evaluate" and isinstance(e.get("round"), int) and e.get("round") > 0 145	    } 146	    missing_evals = sorted(prop_rounds - ev_rounds) 147	    if not log_path.exists(): 148	        detail = "log.jsonl 缺失（无审计记录）" 149	    elif missing_evals: 150	        detail = "缺评估的 propose 轮: " + ", ".join(f"R{r:02d}" for r in missing_evals) 151	    else: 152	        detail = "所有 propose 轮均有同轮 evaluate" 153	    checks.append( 154	        { 155	            "check": "审计链完整（每 propose 轮有同轮 evaluate）", 156	            "pass": not missing_evals and log_path.exists(), 157	            "detail": detail, 158	        } 159	    ) 160	 161	    # 6. 收尾审计链：final 条目必须存在（收尾判词的审计尾） 162	    #    （t6_r1_flash 事故：交付验证 ALL PASS 但 log.jsonl 缺 final — 收尾未落判词） 163	    has_final = any(e.get("action") == "final" for e in log_entries) 164	    checks.append( 165	        { 166	            "check": "收尾审计链完整（final 条目存在）", 167	            "pass": has_final, 168	            "detail": "final 条目存在" if has_final else "log.jsonl 缺 final 条目（收尾未落判词）", 169	        } 170	    ) 171	 172	    return 