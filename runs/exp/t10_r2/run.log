72	 73	 74	def _variant_dict(c) -> dict: 75	    """struct/params → dict (params may be a JSON string; parse it).""" 76	    v = c.get("struct") or c.get("params") 77	    if isinstance(v, str): 78	        try: 79	            v = json.loads(v) 80	        except (json.JSONDecodeError, TypeError): 81	            return {} 82	    return v if isinstance(v, dict) else {} 83	 84	 85	def _cand_type(c) -> str: 86	    """CandidateType (mechanical): smiles=molecule; base only=system; 87	    struct/params variants: electrolyte keys=formulation, else structure.""" 88	    if not isinstance(c, dict): 89	        return "Molecule" 90	    if c.get("smiles"): 91	        return "Molecule" 92	    variant = _variant_dict(c) 93	    if variant: 94	        if any("electrolyte" in str(k).lower() or "transference" in str(k).lower() for k in variant): 95	            return "Formulation" 96	        return "Structure" 97	    if c.get("base"): 98	        return "System" 99	    return "Molecule" 100	 101	 102	def _cand_content(c) -> str: 103	    if not isinstance(c, dict): 104	        return str(c) 105	    if c.get("smiles"): 106	        return str(c["smiles"]) 107	    if c.get("base"): 108	        return str(c["base"]) 109	    variant = _variant_dict(c) 110	    if variant: 111	        return "; ".join(f"{k} = {_fmt_num(v)}" for k, v in variant.items()) 112	    return "" 113	 114	 115	def _source_chip(c) -> str: 116	    source = str(c.get("source") or "") if isinstance(c, dict) else "" 117	    cls = "seed" if source.lower() == "seed" else "free" if source.lower() in ("free_gen", "free") else "" 118	    return f'<span class="chip tag {cls}">{_html_escape(source.upper())}</span>' if source and cls else "" 119	 120	 121	def _cand_component(c) -> str: 122	    """CandidateComponent (mechanical): molecule/formulation→Electrolyte; 123	    system→Cell system; struct/params keys→component.""" 124	    t = _cand_type(c) 125	    if t in ("Molecule", "Formulation"): 126	        return "Electrolyte" 127	    if t == "System": 128	        return "Cell system" 129	    struct = _variant_dict(c) if isinstance(c, dict) else {} 130	    comps = [] 131	    for k in struct: 132	        ks = str(k) 133	        if "Separator" in ks: 134	            comps.append("Separator") 135	        elif "collector" in ks: 136	            comps.append("Current collector") 137	        elif "Electrolyte" in ks: 138	            comps.append("Electrolyte") 139	        elif "Positive electrode" in ks: 140	            comps.append("Cathode") 141	        elif "Negative electrode" in ks: 142	            comps.append("Anode") 143	    if not comps: 144	        return "Structure" 145	    return " + ".join(dict.fromkeys(comps))  # dedupe, keep order 146	 147	 148	def _cand_row(c) -> str: 149	    """Candidate table row: candidate (name+source) | component | type | role | content.""" 150	    if isinstance(c, dict): 151	        name = str(c.get("name") or "") 152	        role = str(c.get("role") or "") 153	        content = _cand_content(c) 154	        src = _source_chip(c) 155	    else: 156	        name, role, content, src = "", "", str(c), "" 157	    head = f"<b>{_html_escape(name)}</b>{src}" if name else f'<span class="sm">{_html_escape(content)}</span>' 158	    return ( 159	        f"<tr><td>{head}</td><td>{_html_escape(_cand_component(c))}</td>" 160	        f"<td>{_html_escape(_cand_type(c))}</td><td>{_html_escape(role)}</td>" 161	        f"<td class='mono'>{_html_escape(content)}</td></tr>" 162	    ) 163	 164	 165	_CAND_HEAD = "<tr><th>Candidate</th><th>Component</th><th>Type</th><th>Role</th><th>Content</th></tr>" 166	 167	 168	def _read_goal(case_dir: str) -> str | None: 169	    """从 config.yaml 读取设计目标（缺失/损坏时返回 None，如实标注）。""" 170	    p = Path(case_dir) / "config.yaml" 171	    if not p.exists(): 172	        return None 173	    try: 174	        import yaml 175	 176	        data = yaml.safe_load(p.read_text(encoding="utf-8")) 177	        goal = data.get("goal") if isinstance(data, dict) else None 178	        return str(goal) if goal else None 179	    except Exception: 180	        return None 181	 182	 183	def _verdict_class(verdict: str) -> str: 184	    v = str(verdict).strip().lower() 185	    if not v: 186	        return "neutral" 187	    if "不达标" in v or v in ("fail", "failed", "reject", "rejected", "no"): 188	        return "bad" 189	    if "达标" in v or v in ("pass", "passed", "ok", "yes"): 190	        return "ok" 191	    return "neutral" 192	 193	 194	def _verdict_badge(verdict: str) -> str: 195	    cls = _verdict_class(verdict) 196	    return f'<span class="badge {cls}">{_html_escape(str(verdict))}</span>' 197	 198	 199	# 五阶段流程（1=规划，2–4=漏斗阶段，5=True DFT/MD endorsement；阶段编号与 SKILL.md 流程一致。 200	# 阶段 5 沿用 .badge.stage.end 铜色样式区分。） 201	_STAGE_LABELS = {1: "STAGE 1 Plan", 2: "STAGE 2 Materials", 3: "STAGE 3 Cell", 4: "STAGE 4 Safety", 5: "STAGE 5 True DFT/MD"} 202	 203	 204	def _stage_badge(stage: int | None) -> str: 205	    """STAGE 小标（blueprint 风格：等宽 10.5px 边框徽章，沿用 .badge + --blue/--accent）。""" 206	    if stage not in _STAGE_LABELS: 207	        return "" 208	    cls = "badge stage end" if stage == 5 else "badge stage" 209	    return f'<span class="{cls}">{_STAGE_LABELS[stage]}</span>' 210	 211	 212	def _stage_range_badge(lo: int, hi: int) -> str: 213	    """轮卡片阶段范围徽章：单阶段沿用 _stage_badge；跨阶段显示 STAGE N–M（en dash）。 214	    范围仅由数字阶段（1–5）构成，阶段 5（True DFT/MD endorsement）可参与范围（如 STAGE 4–5）； 215	    endorse/final 条目不进轮卡片，阶段 5 在Flow overview条中单独显示。""" 216	    if lo == hi: 217	        return _stage_badge(lo) 218	    if lo not in _STAGE_LABELS or hi not in _STAGE_LABELS: 219	        return "" 220	    return f'<span class="badge stage">STAGE {lo}–{hi}</span>' 221	 222	 223	def _entry_stage(e: dict) -> int | None: 224	    """log 条目 → 流程阶段：plan=1（总体设计规划）；mol. propose/funnel=2（材料）； 225	    struct propose=3（电芯）；evaluate 按内容推断（安全Metric=4，结构=3，否则=2）； 226	    endorse/final=5（True DFT/MD endorsement）。""" 227	    action = e.get("action") 228	    if action == "plan": 229	        return 1 230	    if action in ("endorse", "final"): 231	        return 5 232	    if action == "propose": 233	        has_struct = any( 234	            isinstance(c, dict) and c.get("struct") for c in _as_list(e.get("candidates")) 235	        ) 236	        return 3 if has_struct else 2 237	    if action == "funnel": 238	        return 2 239	    if action == "evaluate": 240	        # 先看结构化 metrics（安全Metric=阶段4，结构覆盖=阶段3），文本兜底——不靠"结构"字样碰巧命中 241	        # （实测：agent 日志 evaluate 条目无"结构"字样，曾误判为材料轮=2） 242	        metrics = e.get("metrics") or {} 243	        has_safety = isinstance(metrics.get("T_max_K"), (int, float)) or "plated" in metrics 244	        if has_safety: 245	            return 4 246	        text = json.dumps(e, ensure_ascii=False) 247	        if "struct" in text or "结构" in text: 248	            return 3 249	        return 2 250	    return None 251	 252	 253	def _plot_stage(filename: str) -> int | None: 254	    """曲线文件名 → 阶段：discharge=3（Cell design）、charge/aging=4（安全/老化评估）；无法判定则不贴。""" 255	    low = filename.lower() 256	    if "discharge" in low: 257	        return 3 258	    if "charge" in low or "aging" in low: 259	        return 4 260	    return None 261	 262	 263	def _threshold_text(value) -> str: 264	    if isinstance(value, bool): 265	        return "No plating" if not value else "Plating allowed" 266	    if isinstance(value, dict): 267	        parts = [] 268	        if "min" in value: 269	            parts.append(f"≥ {_fmt_num(value['min'], sig=5)}") 270	        if "max" in value: 271	            parts.append(f"≤ {_fmt_num(value['max'], sig=5)}") 272	        return " · ".join(parts) if parts else "" 273	    return _fmt_num(value) 274	 275	 276	_STAGE_KEYS = ("stage1", "stage2", "stage3", "meta") 277	_STAGE_NAMES = {"stage1": "Materials design", "stage2": "Cell design", "stage3": "Safety assessment", "meta": "Case parameters"} 278	_STAGE1_UNITS = {"max_energy_ev": "eV", "max_homo_ev": "eV"} 279	 280	 281	def _normalize_criteria(criteria: dict) -> dict[str, dict]: 282	    """criteria → {"stage1"/"stage2"/"stage3"/"meta": {...}}。 283	 284	    新协议为显式分层（stageN/meta 键）；旧日志为扁平键（如 T_max_C），按键名归组： 285	    电位窗/淘汰线（homo/energy_ev/voltage/window）→ stage1；容量/Energy density（capacity/density）→ stage2； 286	    温度/析锂（t_max/temp/plat）→ stage3；其余 → meta。 287	    """ 288	    norm: dict[str, dict] = {} 289	    for k in _STAGE_KEYS: 290	        v = criteria.get(k) 291	        norm[k] = dict(v) if isinstance(v, dict) else {} 292	    rest = {k: v for k, v in criteria.items() if k not in _STAGE_KEYS} 293	    if rest: 294	        legacy = {k: {} for k in _STAGE_KEYS} 295	        for k, v in rest.items(): 296	            kl = str(k).lower() 297	            if "homo" in kl or "energy_ev" in kl or "voltage" in kl or "window" in kl: 298	                legacy["stage1"][k] = v 299	            elif "capacity" in kl or "density" in kl: 300	                legacy["stage2"][k] = v 301	            elif "t_max" in kl or "temp" in kl or "plat" in kl: 302	                legacy["stage3"][k] = v 303	            else: 304	                legacy["meta"][k] = v 305	        for k in _STAGE_KEYS: 306	            norm[k] = {**legacy[k], **norm[k]} 307	    return norm 308	 309	 310	def _flat_thresholds(criteria: dict) -> dict: 311	    """stage1–3 Threshold合并为扁平字典（KPI/Achieved列机械比较用；meta 不参与）。""" 312	    norm = _normalize_criteria(criteria) 313	    merged: dict = {} 314	    for k in ("stage1", "stage2", "stage3"): 315	        merged.update(norm[k]) 316	    return merged 317	 318	 319	def _achieve_cell(value, spec) -> str: 320	    """单MetricAchieved格：数值 vs {"min"/"max"} Threshold → ✓/✗ 徽章 + Achieved值；无数据 → 破折号。""" 321	    if isinstance(value, bool): 322	        show = "No plating" if not value else "Plating risk" 323	        if isinstance(spec, bool): 324	            mark = '<span class="badge ok">✓</span>' if value == spec else '<span class="badge bad">✗</span>' 325	            return f"{show} {mark}" 326	        return f'{show} <span class="badge mute">—</span>' 327	    if isinstance(value, (int, float)): 328	        show = _fmt_num(value) 329	        if isinstance(spec, dict): 330	            checks = [] 331	            if "min" in spec and isinstance(spec["min"], (int, float)): 332	                checks.append(value >= spec["min"]) 333	            if "max" in spec and isinstance(spec["max"], (int, float)): 334	                checks.append(value <= spec["max"]) 335	            if checks: 336	                mark = '<span class="badge ok">✓</span>' if all(checks) else '<span class="badge bad">✗</span>' 337	                return f"{show} {mark}" 338	        return f'{show} <span class="badge mute">—</span>' 339	    return '<span class="badge mute">—</span>' 340	 341	 342	def _stage_achieve_badge(stage_key: str, stage_dict: dict, metrics: dict, funnel_latest: dict | None) -> str: 343	    """阶段头部"Achieved"徽章：stage1 看漏斗；stage2/3 看Metric对照；无数据 → mute。""" 344	    if stage_key == "stage1": 345	        if funnel_latest is None: 346	            return '<span class="badge mute">Not run</span>' 347	        n, m = _to_int(funnel_latest.get("passed")), _to_int(funnel_latest.get("disputed")) 348	        # 分歧不是失败（协议："分歧是'该动脑子'的信号"），处置留痕于漏斗明细； 349	        # 阶段 2 Achieved = 有候选通过漏斗（passed > 0） 350	        cls = "ok" if n > 0 else "bad" 351	        return f'<span class="badge {cls}">Achieved · PASS {n} · DISP {m}</span>' 352	    verdicts: list[bool] = [] 353	    for k, spec in stage_dict.items(): 354	        v = metrics.get(k) 355	        if isinstance(v, bool) and isinstance(spec, bool): 356	            verdicts.append(v == spec) 357	        elif isinstance(v, (int, float)) and isinstance(spec, dict) and ("min" in spec or "max" in spec): 358	            if "min" in spec and isinstance(spec["min"], (int, float)): 359	                verdicts.append(v >= spec["min"]) 360	            if "max" in spec and isinstance(spec["max"], (int, float)): 361	                verdicts.append(v <= spec["max"]) 362	    if not verdicts: 363	        return '<span class="badge mute">Not run</span>' 364	    if all(verdicts): 365	        return '<span class="badge ok">All achieved</span>' 366	    return '<span class="badge bad">Partially achieved</span>' 367	 368	 369	def _criteria_html(criteria: dict, log: list[dict]) -> str: 370	    if not criteria: 371	        return ( 372	            '<p class="empty">No data</p>' 373	            '<p class="hint">No criteria recorded (log.jsonl entry 0 missing).</p>' 374	        ) 375	    norm = _normalize_criteria(criteria) 376	    metrics = _latest_metrics(log) 377	    funnels = [e for e in log if e.get("action") == "funnel"] 378	    funnel_latest = funnels[-1] if funnels else None 379	    blocks = [] 380	    for stage_key, name in (("stage1", "Materials design"), ("stage2", "Cell design"), 381	                            ("stage3", "Safety assessment"), ("meta", "Case parameters")): 382	        stage_dict = norm.get(stage_key, {}) 383	        if stage_key == "meta": 384	            head = ('<div class="stage-goal-head"><span class="badge mute">META</span>' 385	                    f'<span class="stage-goal-name">{name}</span></div>') 386	            if not stage_dict: 387	                table = '<p class="empty">Not provided</p>' 388	            else: 389	                rows = "".join( 390	                    "<tr>" 391	                    f"<th scope='row'>{_html_escape(str(k))}</th>" 392	                    f"<td class='num'>{_html_escape(_fmt_num(v))}</td>" 393	                    "</tr>" 394	                    for k, v in stage_dict.items() 395	                ) 396	                table = f'<table class="tbl"><tr><th>Parameter</th><th>Value</th></tr>{rows}</table>' 397	            blocks.append(f'<div class="stage-goal meta">{head}{table}</div>') 398	            continue 399	        stage_num = int(stage_key[-1]) 400	        head = ( 401	            f'<div class="stage-goal-head">{_stage_badge(stage_num)}' 402	            f'<span class="stage-goal-name">{name}</span>' 403	            f"{_stage_achieve_badge(stage_key, stage_dict, metrics, funnel_latest)}</div>" 404	        ) 405	        if not stage_dict: 406	            table = '<p class="empty">No separate targets (see other stages)</p>' 407	            blocks.append(f'<div class="stage-goal">{head}{table}</div>') 408	            continue 409	        has_achieve = stage_key in ("stage2", "stage3") 410	        head_cells = "<tr><th>Metric</th><th>Threshold</th>" + ("<th>Achieved</th>" if has_achieve else "") + "<th>Note</th></tr>" 411	        rows = [] 412	        for k, v in stage_dict.items(): 413	            if stage_key == "stage1" and not isinstance(v, (dict, bool)): 414	                unit = _STAGE1_UNITS.get(k, "") 415	                threshold = f"≤ {_fmt_num(v)}" + (f" {unit}" if unit else "") 416	            else: 417	                threshold = _threshold_text(v) 418	            meta = ( 419	                " · ".join(f"{mk}={_fmt_num(mv)}" for mk, mv in v.items() if mk not in ("min", "max")) 420	                if isinstance(v, dict) 421	                else "" 422	            ) 423	            cells = ( 424	                f"<th scope='row'>{_html_escape(str(k))}</th>" 425	                f"<td class='num'>{_html_escape(threshold)}</td>" 426	            ) 427	            if has_achieve: 428	                cells += f"<td class='num'>{_achieve_cell(metrics.get(k), v)}</td>" 429	            cells += f"<td class='crit-meta'>{_html_escape(meta)}</td>" 430	            rows.append(f"<tr>{cells}</tr>") 431	        table = f'<table class="tbl">{head_cells}{"".join(rows)}</table>' 432	        blocks.append(f'<div class="stage-goal">{head}{table}</div>') 433	    return f'<div class="stage-goals">{"".join(blocks)}</div>' 434	 435	 436	def _candidates_html(log: list[dict]) -> str: 437	    """SHEET 01 涉及候选：全部 propose/endorse 候选去重后的总表（首次出现顺序）。""" 438	    seen: dict[str, object] = {} 439	    order: list[str] = [] 440	    for e in log: 441	        for c in _as_list(e.get("candidates")): 442	            key = str(c.get("name") or c.get("smiles") or "") if isinstance(c, dict) else str(c) 443	            if key and key not in seen: 444	                seen[key] = c 445	                order.append(key) 446	    if not order: 447	        return '<p class="empty">No data</p>' 448	    rows = "".join(_cand_row(seen[k]) for k in order) 449	    return f'<table class="tbl cand">{_CAND_HEAD}{rows}</table>' 450	 451	 452	def _goal_mark(ok: bool) -> str: 453	    return '<b class="goal-ok">✓</b>' if ok else '<b class="goal-bad">✗</b>' 454	 455	 456	def _goal_parts(stage_key: str, stage_dict: dict) -> str: 457	    """阶段目标压缩文本：'E ≤ 0.0 eV · HOMO ≤ −6.0 eV' / 'Energy density ≥ 300 Wh/kg' 等。""" 458	    labels = { 459	        "max_energy_ev": "E", "max_homo_ev": "HOMO", 460	        "energy_density_wh_kg": "Energy density", "capacity_ah": "Capacity", "T_max_K": "T_max", 461	    } 462	    units = {"max_energy_ev": "eV", "max_homo_ev": "eV", "energy_density_wh_kg": "Wh/kg", "T_max_K": "K"} 463	    parts = [] 464	    for k, v in stage_dict.items(): 465	        if isinstance(v, bool): 466	            parts.append(_threshold_text(v)) 467	            continue 468	        if isinstance(v, str): 469	            continue  # 自由文本规则（如 plating_rule）不进入压缩目标行 470	        label = labels.get(k, str(k)) 471	        if isinstance(v, dict): 472	            t = _threshold_text(v) 473	            parts.append(f"{label} {t}" if t else f"{label} {_fmt_num(v)}") 474	        else: 475	            sign = "≤ " if stage_key == "stage1" else "" 476	            unit = units.get(k, "") 477	            parts.append(f"{label} {sign}{_fmt_num(v)}{' ' + unit if unit else ''}") 478	    return " · ".join(parts) if parts else "No targets" 479	 480	 481	def _flow_achieve(stage_key: str, stage_dict: dict, log: list[dict]) -> str: 482	    """流程条Achieved摘要：stage1 看最新漏斗；stage2/3 看最新评估Metric对照。""" 483	    if stage_key == "stage1": 484	        funnels = [e for e in log if e.get("action") == "funnel"] 485	        if not funnels: 486	            return "—" 487	        f = funnels[-1] 488	        n, m = _to_int(f.get("passed")), _to_int(f.get("disputed")) 489	        # 阶段 2 Achieved = 有候选通过漏斗（分歧已处置，留痕于漏斗明细） 490	        return f"PASS {n} · DISP {m} {_goal_mark(n > 0)}" 491	    metrics = _latest_metrics(log) 492	    if not stage_dict or not metrics: 493	        return "—" 494	    parts = [] 495	    for k, v in stage_dict.items(): 496	        mv = metrics.get(k) 497	        if isinstance(v, bool) and isinstance(mv, bool): 498	            parts.append(f"{'No plating' if not mv else 'Plating risk'}{_goal_mark(mv == v)}") 499	        elif isinstance(mv, (int, float)) and isinstance(v, dict) and ("min" in v or "max" in v): 500	            ok = True 501	            if "min" in v and isinstance(v["min"], (int, float)): 502	                ok = ok and mv >= v["min"] 503	            if "max" in v and isinstance(v["max"], (int, float)): 504	                ok = ok and mv <= v["max"] 505	            parts.append(f"{_fmt_num(mv)}{_goal_mark(ok)}") 506	    return " · ".join(parts) if parts else "—" 507	 508	 509	def _flow_html(log: list[dict], cell_files: list[tuple[str, dict]], criteria: dict) -> str: 510	    """概览区Flow overview条：五阶段徽章，各带计数/结论摘要 + 目标与Achieved（由 criteria 与 log 机械推导）。 511	 512	    阶段1 总体设计规划=plan 条目；阶段2 Materials design=mol. propose/funnel（判定层 stage1）； 513	    阶段3 Cell design=struct propose/discharge 曲线（判定层 stage2）； 514	    阶段4 Safety assessment=charge45 曲线（判定层 stage3）；阶段5 True DFT/MD endorsement=endorse/final（含最终结论）。 515	    """ 516	    mol_prop = struct_prop = funnel_n = endorse_n = final_n = plan_n = 0 517	    for e in log: 518	        action = e.get("action") 519	        if action == "funnel": 520	            funnel_n += 1 521	        elif action == "endorse": 522	            endorse_n += 1 523	        elif action == "final": 524	            final_n += 1 525	        elif action == "plan": 526	            plan_n += 1 527	        elif action == "propose": 528	            for c in _as_list(e.get("candidates")): 529	                if isinstance(c, dict) and c.get("struct"): 530	                    struct_prop += 1 531	                else: 532	                    mol_prop += 1 533	    n_discharge = sum(1 for fname, _ in cell_files if _plot_stage(fname) == 3) 534	    n_charge45 = sum(1 for fname, _ in cell_files if _plot_stage(fname) == 4) 535	    finals = [e for e in log if e.get("action") == "final"] 536	    verdict = str(finals[-1].get("verdict") or "") if finals else "" 537	    close_sum = f"Endorse {endorse_n} · Final {final_n}" + (f" · Verdict {verdict}" if verdict else "") 538	    norm = _normalize_criteria(criteria) 539	    # 流程阶段 → 判定层键映射（编号独立，阶段 2/3/4 分别对应判定层 stage1/2/3） 540	    stage_to_key = {2: "stage1", 3: "stage2", 4: "stage3"} 541	    items = ( 542	        (1, "Stage 1 · Overall planning", f"plan {plan_n} · design_plan.md"), 543	        (2, "Stage 2 · Materials design", f"mol. propose {mol_prop} · funnel {funnel_n}"), 544	        (3, "Stage 3 · Cell design", f"struct. propose {struct_prop} · discharge curves {n_discharge}"), 545	        (4, "Stage 4 · Safety assessment", f"4C charge curves {n_charge45}"), 546	        (5, "Stage 5 · True DFT/MD endorsement", close_sum), 547	    ) 548	    blocks = [] 549	    for stage, name, count in items: 550	        goal_html = "" 551	        if stage in (2, 3, 4): 552	            stage_key = stage_to_key[stage] 553	            stage_dict = norm.get(stage_key, {}) 554	            goal_html = ( 555	                f'<div class="flow-goal"><span class="g-label">Goal</span>' 556	                f"<span>{_html_escape(_goal_parts(stage_key, stage_dict))}</span></div>" 557	                f'<div class="flow-goal"><span class="g-label">Achieved</span>' 558	                f"<span>{_flow_achieve(stage_key, stage_dict, log)}</span></div>" 559	            ) 560	        blocks.append( 561	            f'<div class="flow-item {"end" if stage == 5 else ""}">{_stage_badge(stage)}' 562	            f'<div class="flow-name">{_html_escape(name)}</div>' 563	            f'<div class="flow-count">{_html_escape(count)}</div>{goal_html}</div>' 564	        ) 565	    return f'<div class="flow">{"".join(blocks)}</div>' 566	 567	 568	def _kpi_compare(value, thresholds: dict, key: str, direction: str) -> tuple[str, str]: 569	    """关键结果 vs 扁平化Threshold（stage1–3 合并）的机械比较 → (颜色类, Threshold说明)。""" 570	    spec = thresholds.get(key) 571	    thr = spec.get(direction) if isinstance(spec, dict) else None 572	    if not isinstance(value, (int, float)) or not isinstance(thr, (int, float)): 573	        return "", "" 574	    ok = (value >= thr) if direction == "min" else (value <= thr) 575	    sign = "≥" if direction == "min" else "≤" 576	    return ("ok" if ok else "bad"), f"Threshold {sign} {_fmt_num(thr, sig=5)}" 577	 578	 579	def _kpi_item(label: str, value, unit: str, cls: str, sub: str) -> str: 580	    num = _fmt_num(value) if value is not None else "N/A" 581	    cls = cls or ("mute" if value is None else "") 582	    unit_html = f'<span class="kpi-unit">{_html_escape(unit)}</span>' if unit else "" 583	    return ( 584	        f'<div class="kpi-item"><div class="kpi-label">{_html_escape(label)}</div>' 585	        f'<div class="kpi-num {cls}">{_html_escape(num)}{unit_html}</div>' 586	        f'<div class="kpi-sub">{_html_escape(sub)}</div></div>' 587	    ) 588	 589	 590	def _latest_metrics(log: list[dict]) -> dict: 591	    for e in reversed(log): 592	        if e.get("action") == "evaluate" and isinstance(e.get("metrics"), dict): 593	            return e["metrics"] 594	    return {} 595	 596	 597	def _kpi_html(metrics: dict, criteria: dict) -> str: 598	    thresholds = _flat_thresholds(criteria) 599	    items = [] 600	    for key, label, unit, direction in ( 601	        ("energy_density_wh_kg", "Energy density", "Wh/kg", "min"), 602	        ("capacity_ah", "Capacity", "Ah", None), 603	        ("T_max_K", "Max temperature", "K", "max"), 604	    ): 605	        value = metrics.get(key) if isinstance(metrics.get(key), (int, float)) else None 606	        cls, sub = "", "" 607	        if direction and value is not None: 608	            cls, sub = _kpi_compare(value, thresholds, key, direction) 609	        if key == "T_max_K" and value is not None: 610	            conv = f"≈ {value - 273.15:.1f} °C" 611	            sub = f"{sub} · {conv}" if sub else conv 612	        items.append(_kpi_item(label, value, unit, cls, sub)) 613	    plated = metrics.get("plated") 614	    if isinstance(plated, bool): 615	        if not plated: 616	            items.append(_kpi_item("Plating", "No plating", "", "ok", "anode potential stayed ≥ 0 V")) 617	        else: 618	            items.append(_kpi_item("Plating", "Plating risk", "", "bad", "anode potential dropped below 0 V")) 619	    else: 620	        items.append(_kpi_item("Plating", None, "", "mute", "Not provided")) 621	    return f'<div class="kpi-grid">{"".join(items)}</div>' 622	 623	 624	def _header_html(case_dir: str, log: list[dict], criteria: dict) -> str: 625	    case_name = Path(case_dir).name or "case" 626	    goal = _read_goal(case_dir) or "(Goal not recorded in config.yaml)" 627	    meta_criteria = _normalize_criteria(criteria).get("meta", {}) 628	    meta = [] 629	    if "real_compute" in meta_criteria: 630	        meta.append("Real compute on" if meta_criteria["real_compute"] is True else "Real compute off") 631	    meta_html = "".join(f"<span>{_html_escape(m)}</span>" for m in meta) 632	 633	    final_entries = [e for e in log if e.get("action") == "final"] 634	    verdict = str(final_entries[-1].get("verdict") or "") if final_entries else "" 635	    if not verdict: 636	        verdict, vcls = "Not adjudicated", "neutral" 637	    else: 638	        vcls = _verdict_class(verdict) 639	    verdict_html = ( 640	        '<div class="verdict-block"><div class="eyebrow light">Conclusion</div>' 641	        f'<div class="verdict {vcls}">{_html_escape(verdict)}</div></div>' 642	    ) 643	 644	    metrics = _latest_metrics(log) 645	    return ( 646	        '<div class="head-row">' 647	        '<div class="head-main">' 648	        '<div class="eyebrow light">Virtual Battery Factory · Case Design Report</div>' 649	        f'<h1 class="case-name">{_html_escape(case_name)}</h1>' 650	        f'<p class="goal">{_html_escape(goal)}</p>' 651	        f'<p class="head-meta">{meta_html}</p>' 652	        "</div>" 653	        f"{verdict_html}" 654	        "</div>" 655	        f"{_kpi_html(metrics, criteria)}" 656	    ) 657	 658	 659	def _propose_html(e: dict) -> str: 660	    cands = _as_list(e.get("candidates")) 661	    rows = "".join(_cand_row(c) for c in cands) 662	    table = f'<table class="tbl cand">{_CAND_HEAD}{rows}</table>' if rows else "" 663	    reason = e.get("llm_reason") 664	    reason_html = f'<p class="reason">{_html_escape(str(reason))}</p>' if reason else "" 665	    return ( 666	        '<div class="blk"><div class="blk-label">Propose · Candidates</div>' 667	        f"{table}{reason_html}</div>" 668	    ) 669	 670	 671	def _funnel_entry_html(e: dict) -> str: 672	    chips = "".join( 673	        f'<span class="chip">{lab} <b class="num">{_to_int(e.get(k))}</b></span>' 674	        for k, lab in (("passed", "PASS"), ("rejected", "REJECT"), ("disputed", "DISP.")) 675	    ) 676	    table = "" 677	    disp = _as_list(e.get("dispositions")) 678	    if disp: 679	        rows = [] 680	        for d in disp: 681	            if isinstance(d, dict): 682	                name = str(d.get("name") or "") 683	                status = str(d.get("status") or "") 684	                reason = str(d.get("reason") or "") 685	                cls = {"rejected": "bad", "passed": "ok", "disputed": "warn"}.get(status, "mute") 686	                badge = f'<span class="badge {cls}">{_html_escape(status)}</span>' 687	                rows.append( 688	                    f"<tr><td>{_html_escape(name)}</td><td>{badge}</td>" 689	                    f"<td>{_html_escape(reason)}</td></tr>" 690	                ) 691	            else: 692	                rows.append(f"<tr><td>{_html_escape(str(d))}</td><td></td><td></td></tr>") 693	        table = ( 694	            f'<table class="tbl"><tr><th>Candidate</th><th>Disposition</th><th>Reason</th></tr>' 695	            f'{"".join(rows)}</table>' 696	        ) 697	    detail = e.get("detail") 698	    detail_html = f"<p>{_html_escape(str(detail))}</p>" if detail else "" 699	    return f'<div class="blk"><div class="blk-label">Funnel · Screening</div>{chips}{table}{detail_html}</div>' 700	 701	 702	def _evaluate_html(e: dict) -> str: 703	    metrics = e.get("metrics") or {} 704	    rows = "".join( 705	        f"<tr><td>{_html_escape(str(k))}</td>" 706	        f"<td class='num'>{_html_escape(_fmt_num(v))}</td></tr>" 707	        for k, v in metrics.items() 708	    ) 709	    verdict = e.get("verdict") 710	    verdict_html = _verdict_badge(str(verdict)) if verdict else '<span class="badge mute">N/A</span>' 711	    cmp_table = "" 712	    comp = _as_list(e.get("comparison")) 713	    if comp: 714	        keys: list[str] = [] 715	        for c in comp: 716	            if isinstance(c, dict): 717	                for k in (c.get("metrics") or {}): 718	                    if k not in keys: 719	                        keys.append(k) 720	        if keys: 721	            head = ( 722	                "<tr><th>Candidate</th>" 723	                + "".join(f"<th>{_html_escape(str(k))}</th>" for k in keys) 724	                + "<th>Verdict</th></tr>" 725	            ) 726	            body = [] 727	            for c in comp: 728	                if not isinstance(c, dict): 729	                    body.append(f"<tr><td>{_html_escape(str(c))}</td></tr>") 730	                    continue 731	                name = str(c.get("name") or c.get("candidate") or "") 732	                m = c.get("metrics") or {} 733	                cells = f"<td>{_html_escape(name)}</td>" 734	                for k in keys: 735	                    if k not in m: 736	                        cells += "<td class='num'>—</td>" 737	                    elif isinstance(m[k], bool): 738	                        cells += f"<td class='num'>{'No plating' if not m[k] else 'Plating risk'}</td>" 739	                    else: 740	                        cells += f"<td class='num'>{_html_escape(_fmt_num(m[k]))}</td>" 741	                v = c.get("verdict") 742	                cells += ( 743	                    f"<td>{_verdict_badge(str(v))}</td>" if v 744	                    else '<td><span class="badge mute">—</span></td>' 745	                ) 746	                body.append(f"<tr>{cells}</tr>") 747	            cmp_table = f'<table class="tbl">{head}{"".join(body)}</table>' 748	    note = e.get("note") 749	    note_html = f'<p class="reason">{_html_escape(str(note))}</p>' if note else "" 750	    return ( 751	        f'<div class="blk"><div class="blk-label">Evaluate {verdict_html}</div>' 752	        f'<table class="tbl"><tr><th>Metric</th><th>Value</th></tr>{rows}</table>{cmp_table}{note_html}</div>' 753	    ) 754	 755	 756	def _rounds_html(log: list[dict]) -> str: 757	    groups: dict[int, list[dict]] = {} 758	    for e in log: 759	        r = e.get("round") 760	        if r is None or _to_int(r) <= 0: 761	            continue 762	        if e.get("action") not in ("propose", "funnel", "evaluate"): 763	            continue 764	        groups.setdefault(_to_int(r), []).append(e) 765	    if not groups: 766	        return '<p class="empty">No data</p>' 767	    cards = [] 768	    first_round = min(groups) 769	    for r, entries in sorted(groups.items()): 770	        ev = next((e for e in entries if e.get("action") == "evaluate"), None) 771	        verdict = str(ev.get("verdict") or "") if ev else "" 772	        badge = _verdict_badge(verdict) if verdict else "" 773	        stages = [s for s in (_entry_stage(e) for e in entries) if s is not None] 774	        stage_html = _stage_range_badge(min(stages), max(stages)) if stages else "" 775	        subs = [] 776	        prop = next((e for e in entries if e.get("action") == "propose"), None) 777	        if prop: 778	            subs.append(f"{len(_as_list(prop.get('candidates')))} candidates") 779	        m = ev.get("metrics", {}) if ev else {} 780	        if isinstance(m.get("T_max_K"), (int, float)): 781	            subs.append(f"T_max {_fmt_num(m['T_max_K'])} K") 782	        if isinstance(m.get("plated"), bool): 783	            subs.append("No plating" if not m["plated"] else "Plating risk") 784	        sub = f'<span class="round-sub">{" · ".join(subs)}</span>' if subs else "" 785	        body = [] 786	        for e in entries: 787	            action = e.get("action") 788	            if action == "propose": 789	                body.append(_propose_html(e)) 790	            elif action == "funnel": 791	                body.append(_funnel_entry_html(e)) 792	            elif action == "evaluate": 793	                body.append(_evaluate_html(e)) 794	        open_attr = " open" if r == first_round else "" 795	        cards.append( 796	            f'<details class="round"{open_attr}><summary>' 797	            f'<span class="round-no">ROUND {r:02d}</span>{stage_html}{badge}{sub}' 798	            f'</summary><div class="round-body">{"".join(body)}</div></details>' 799	        ) 800	    return "".join(cards) 801	 802	 803	def _rounds_ov_html(log: list[dict]) -> str: 804	    """迭代轨迹顶部Round overview表：轮次/阶段/候选数/关键Metric/结论（由 propose/evaluate 机械推导）。""" 805	    groups: dict[int, list[dict]] = {} 806	    for e in log: 807	        r = e.get("round") 808	        if r is None or _to_int(r) <= 0: 809	            continue 810	        if e.get("action") not in ("propose", "funnel", "evaluate"): 811	            continue 812	        groups.setdefault(_to_int(r), []).append(e) 813	    if not groups: 814	        return "" 815	    rows = [] 816	    for r, entries in sorted(groups.items()): 817	        ev = next((e for e in entries if e.get("action") == "evaluate"), None) 818	        prop = next((e for e in entries if e.get("action") == "propose"), None) 819	        stages = [s for s in (_entry_stage(e) for e in entries) if s is not None] 820	        stage_html = _stage_range_badge(min(stages), max(stages)) if stages else "" 821	        n_cand = len(_as_list(prop.get("candidates"))) if prop else 0 822	        m = ev.get("metrics", {}) if ev else {} 823	        ed = ( 824	            _fmt_num(m["energy_density_wh_kg"]) 825	            if isinstance(m.get("energy_density_wh_kg"), (int, float)) 826	            else "—" 827	        ) 828	        cap = _fmt_num(m["capacity_ah"]) if isinstance(m.get("capacity_ah"), (int, float)) else "—" 829	        tmax = _fmt_num(m["T_max_K"]) if isinstance(m.get("T_max_K"), (int, float)) else "—" 830	        if isinstance(m.get("plated"), bool): 831	            plated = ( 832	                '<span class="badge ok">No plating</span>' if not m["plated"] 833	                else '<span class="badge bad">Plating risk</span>' 834	            ) 835	        else: 836	            plated = '<span class="badge mute">—</span>' 837	        verdict = str(ev.get("verdict") or "") if ev else "" 838	        v_html = _verdict_badge(verdict) if verdict else '<span class="badge mute">—</span>' 839	        rows.append( 840	            f"<tr><td class='num'>R{_to_int(r):02d}</td><td>{stage_html}</td>" 841	            f"<td class='num'>{n_cand}</td><td class='num'>{_html_escape(ed)}</td>" 842	            f"<td class='num'>{_html_escape(cap)}</td><td class='num'>{_html_escape(tmax)}</td>" 843	            f"<td>{plated}</td><td>{v_html}</td></tr>" 844	        ) 845	    head = ( 846	        "<tr><th>Round</th><th>Stage</th><th>Cands</th><th>Energy density Wh/kg</th>" 847	        "<th>Capacity Ah</th><th>T_max K</th><th>Plating</th><th>Verdict</th></tr>" 848	    ) 849	    return f'<div class="ov-head">Round overview</div><table class="tbl ov">{head}{"".join(rows)}</table>' 850	 851	 852	def _trend_bars(caption: str, rows: list[tuple[str, float]], threshold: tuple | None) -> str: 853	    """逐轮Metric柱状图（内联 SVG）；threshold = (数值, 标签) 画参考线。""" 854	    W, H = 340, 200 855	    pad_l, pad_r, pad_t, pad_b = 42, 12, 16, 28 856	    vals = [v for _, v in rows if isinstance(v, (int, float))] 857	    if not vals: 858	        return "" 859	    tvals = [threshold[0]] if threshold and isinstance(threshold[0], (int, float)) else [] 860	    lo, hi = min(vals + tvals), max(vals + tvals) 861	    if lo > 0: 862	        lo = 0.0 863	    span = (hi - lo) or 1.0 864	    n = len(rows) 865	    gap = (W - pad_l - pad_r) / n 866	    bw = min(46.0, gap * 0.6) 867	    els = [] 868	    for i in range(3): 869	        gy = pad_t + (H - pad_t - pad_b) * i / 2 870	        els.append(f'<line class="grid" x1="{pad_l}" y1="{gy:.1f}" x2="{W - pad_r}" y2="{gy:.1f}"/>') 871	        els.append( 872	            f'<text x="{pad_l - 4}" y="{gy + 3:.1f}" text-anchor="end">{_fmt_num(hi - span * i / 2)}</text>' 873	        ) 874	    els.append(f'<line class="axis" x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{H - pad_b}"/>') 875	    els.append(f'<line class="axis" x1="{pad_l}" y1="{H - pad_b}" x2="{W - pad_r}" y2="{H - pad_b}"/>') 876	    for i, (label, v) in enumerate(rows): 877	        x = pad_l + gap * i + (gap - bw) / 2 878	        h = (v - lo) / span * (H - pad_t - pad_b) 879	        y = H - pad_b - h 880	        els.append(f'<rect class="bar" x="{x:.1f}" y="{y:.1f}" width="{bw:.1f}" height="{h:.1f}"/>') 881	        els.append( 882	            f'<text x="{pad_l + gap * i + gap / 2:.1f}" y="{H - pad_b + 15:.1f}" ' 883	            f'text-anchor="middle">{_html_escape(str(label))}</text>' 884	        ) 885	        els.append( 886	            f'<text x="{pad_l + gap * i + gap / 2:.1f}" y="{y - 5:.1f}" ' 887	            f'text-anchor="middle">{_fmt_num(v)}</text>' 888	        ) 889	    if threshold and isinstance(threshold[0], (int, float)): 890	        ty = H - pad_b - (threshold[0] - lo) / span * (H - pad_t - pad_b) 891	        els.append(f'<line class="thr" x1="{pad_l}" y1="{ty:.1f}" x2="{W - pad_r}" y2="{ty:.1f}"/>') 892	        els.append( 893	            f'<text class="t-label" x="{W - pad_r}" y="{ty - 5:.1f}" text-anchor="end">' 894	            f'{_html_escape(str(threshold[1]))} {_fmt_num(threshold[0], sig=5)}</text>' 895	        ) 896	    svg = ( 897	        f'<svg class="chart" viewBox="0 0 {W} {H}" role="img" aria-label="{_attr_escape(caption)}">' 898	        f"<title>{_html_escape(caption)}</title>" + "".join(els) + "</svg>" 899	    ) 900	    return f'<div class="trend"><div class="trend-caption">{_html_escape(caption)}</div>{svg}</div>' 901	 902	 903	def _trends_html(log: list[dict], criteria: dict) -> str: 904	    """逐轮Energy density/T_max Trends图（evaluate metrics 机械推导，Threshold线来自 criteria）。""" 905	    evals = [e for e in log if e.get("action") == "evaluate"] 906	    ed_rows: list[tuple[str, float]] = [] 907	    tmax_rows: list[tuple[str, float]] = [] 908	    for e in evals: 909	        r = e.get("round") 910	        label = f"R{_to_int(r):02d}" if r is not None else "R—" 911	        m = e.get("metrics") or {} 912	        if isinstance(m.get("energy_density_wh_kg"), (int, float)): 913	            ed_rows.append((label, m["energy_density_wh_kg"])) 914	        if isinstance(m.get("T_max_K"), (int, float)): 915	            tmax_rows.append((label, m["T_max_K"])) 916	    if not ed_rows and not tmax_rows: 917	        return "" 918	    thr = _flat_thresholds(criteria) 919	    ed_thr = None 920	    spec = thr.get("energy_density_wh_kg") 921	    if isinstance(spec, dict) and "min" in spec: 922	        ed_thr = (spec["min"], "Target ≥") 923	    tmax_thr = None 924	    spec = thr.get("T_max_K") 925	    if isinstance(spec, dict) and "max" in spec: 926	        tmax_thr = (spec["max"], "Limit ≤") 927	    charts = [] 928	    if ed_rows: 929	        charts.append(_trend_bars("Energy density trend (per evaluate round)", ed_rows, ed_thr)) 930	    if tmax_rows: 931	        charts.append(_trend_bars("T_max trend (per evaluate round)", tmax_rows, tmax_thr)) 932	    if not charts: 933	        return "" 934	    return f'<div class="ov-head">Trends</div><div class="trends">{"".join(charts)}</div>' 935	 936	 937	def _funnel_html(log: list[dict]) -> str: 938	    entries = [e for e in log if e.get("action") == "funnel"] 939	    if not entries: 940	        return '<p class="empty">No data</p>' 941	    totals = {k: sum(_to_int(e.get(k)) for e in entries) for k in ("passed", "rejected", "disputed")} 942	    stats = ( 943	        f'<div class="stat pass"><div class="stat-num">{totals["passed"]}</div>' 944	        '<div class="stat-label">Passed</div></div>' 945	        f'<div class="stat rej"><div class="stat-num">{totals["rejected"]}</div>' 946	        '<div class="stat-label">Rejected</div></div>' 947	        f'<div class="stat dis"><div class="stat-num">{totals["disputed"]}</div>' 948	        '<div class="stat-label">Disputed</div></div>' 949	    ) 950	    details = [] 951	    for e in entries: 952	        r = e.get("round") 953	        label = f"R{_to_int(r):02d}" if r is not None else "R—" 954	        detail = e.get("detail") 955	        detail_html = f"<p>{_html_escape(str(detail))}</p>" if detail else "" 956	        details.append(f'<div class="funnel-detail"><span class="chip">{label}</span>{detail_html}</div>') 957	    return f'<div class="stats">{stats}</div>{"".join(details)}' 958	 959	 960	def _load_cell_curves(case_dir: str) -> list[tuple[str, dict]]: 961	    """cell/*.json 中 run-pyamm 曲线输出（含 time_s 与至少一条等长曲线序列）。""" 962	    cell_dir = Path(case_dir) / "cell" 963	    if not cell_dir.is_dir(): 964	        return [] 965	    out = [] 966	    for p in sorted(cell_dir.glob("*.json")): 967	        try: 968	            data = json.loads(p.read_text(encoding="utf-8")) 969	        except (json.JSONDecodeError, OSError): 970	            continue 971	        if not isinstance(data, dict): 972	            # e.g. log-evaluate --batch-file inputs (rN_batch_eval.json are JSON 973	            # lists) carry