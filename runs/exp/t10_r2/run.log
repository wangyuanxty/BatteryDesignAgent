ine class="grid" x1="{gx:.1f}" y1="{y0}" x2="{gx:.1f}" y2="{y1}"/>') 1025	    for i in range(5): 1026	        gy = y0 + (y1 - y0) * i / 4 1027	        elements.append(f'<line class="grid" x1="{x0}" y1="{gy:.1f}" x2="{x1}" y2="{gy:.1f}"/>') 1028	    elements.append(f'<line class="axis" x1="{x0}" y1="{y0}" x2="{x0}" y2="{y1}"/>') 1029	    elements.append(f'<line class="axis" x1="{x0}" y1="{y1}" x2="{x1}" y2="{y1}"/>') 1030	 1031	    for key, cls in ( 1032	        ("voltage_v", "s-voltage"), 1033	        ("anode_potential_v", "s-anode"), 1034	        ("capacity_ah_per_cycle", "s-voltage"), 1035	    ): 1036	        vals = series.get(key) 1037	        if vals is None: 1038	            continue 1039	        vmin, vmax = min(vals), max(vals) 1040	        span = (vmax - vmin) or 0.0 1041	        pts, rows = [], [] 1042	        for i in range(0, len(t), stride): 1043	            px = x0 + (t[i] - tmin) / span_t * (x1 - x0) if span_t else x0 1044	            py = y1 - (vals[i] - vmin) / span * (y1 - y0) if span else (y0 + y1) / 2 1045	            pts.append(f"{px:.1f},{py:.1f}") 1046	            rows.append([round(t[i], 2), round(vals[i], 4)]) 1047	        elements.append(f'<path class="{cls}" d="M{" L".join(pts)}"/>') 1048	        tooltip[f"{key}"] = rows 1049	        side = 1 if key in ("voltage_v", "capacity_ah_per_cycle") else -1 1050	        if side > 0: 1051	            elements.append(f'<text x="{x0 - 6}" y="{y0 + 4}" text-anchor="end">{_fmt_num(vmax)}</text>') 1052	            elements.append(f'<text x="{x0 - 6}" y="{y1 + 4}" text-anchor="end">{_fmt_num(vmin)}</text>') 1053	        else: 1054	            elements.append(f'<text x="{x1 + 6}" y="{y0 + 4}" fill="var(--accent)">{_fmt_num(vmax)}</text>') 1055	            elements.append(f'<text x="{x1 + 6}" y="{y1 + 4}" fill="var(--accent)">{_fmt_num(vmin)}</text>') 1056	 1057	    if "voltage_v" in series: 1058	        elements.append(f'<text x="{x0 + 4}" y="{y0 + 10}" fill="var(--blue)">— voltage_v [V]</text>') 1059	    i