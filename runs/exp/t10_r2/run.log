te` 内部键携带证据来源标注（两者都不进条目 metrics）。 58	    """ 59	    metrics: dict[str, tuple] = {} 60	    potentials: dict[Path, list] = {} 61	    for f in files: 62	        data = json.loads(f.read_text(encoding="utf-8-sig")) 63	        if not isinstance(data, dict): 64	            continue 65	        for k, v in data.items(): 66	            if isinstance(v, (int, float, bool)): 67	                metrics[k] = (v, f) 68	            elif k == "anode_potential_v" and isinstance(v, list) and v: 69	                potentials[f] = v 70	    if "plated" not in metrics and potentials: 71	        f, v = max(potentials.items(), key=lambda kv: len(kv[1]))  # 最完整时序 72	        mn = min(v) 73	        metrics["plated"] = (mn < 0.0, f) 74	        metrics["_plated_note"] = ( 75	            f"anode_potential_v (min={mn:.4g}V{'<' if mn < 0 else '>'}0 推导)", 76	            f, 77	        ) 78	    return metrics 79	 80	 81	def _rel_to(path: Path, base: Path) -> str: 82	    """来源路径相对化：在 base 下 → 相对 posix 串；否则回退绝对路径。""" 83	    try: 84	        return path.relative_to(base).as_posix() 85	    except ValueError: 86	        return path.as_posix() 87	 88	 89	def _threshold_ok(value, threshold) -> bool: 90	    """阈值三形态：{"min": n} / {"max": n} / 布尔等值 / 标量数值（视为 min）。""" 91	    if isinstance(threshold, dict): 92	        lo = threshold.get("min") 93	        hi = threshold.get("max") 94	        if lo is not None or hi is not None: 95	            # 有数值边界但 value 不可比（str/list）→ 不过；无任何边界 → 视为未限定通过 96	            if not isinstance(value, (int, float)): 97	                return False 98	            if isinstance(lo, (int, float)) and value < lo: 99	                return False 100	            if isinstance(hi, (int, float)) and value > hi: 101	                return False 102	        return True 103	    if isinstance(threshold, bool): 104	        return bool(value) == threshold 105	    if isinstance(threshold, (int, float)) and isinstance(value, (int, float)): 106	        return value >= threshold 107	    return False  # 