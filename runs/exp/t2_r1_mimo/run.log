ss_kg\"] * 1000\n\nprint(\"\\n--- Summary ---\")\nprint(f\"{'Variant':<10} {'ED Wh/kg':>10} {'Cap Ah':>8} {'Plated':>8} {'T_max K':>8} {'min V':>8}\")\nfor v in variants:\n    r = results[v]\n    print(f\"{v:<10} {r.get('ed','?'):>10.2f} {r['capacity_1c']:>8.4f} {str(r['plated']):>8} {r['T_max_4c']:>8.2f} {r['min_anode_v']:>8.4f}\")\n"}
