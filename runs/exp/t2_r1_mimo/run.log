# ~5x lower\n    },\n}\n\nfor name, params in variants.items():\n    path = f\"runs/exp/t2_r1_mimo/cell/params_{name}.json\"\n    with open(path, \"w\") as f:\n        json.dump(params, f)\n    print(f\"Created {path}: {len(params)} overrides\")\n\nprint(\"Done\")\n"}
