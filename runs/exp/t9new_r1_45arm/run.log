)) 53	    if abs(total - 1.0) > 1e-6: 54	        raise ValueError(f"TM fractions must sum to 1; got {tm} (sum={total})") 55	    return tm 56	 57	 58	def _largest_remainder(fractions: dict[str, float], n: int) -> dict[str, int]: 59	    """组分分数 → 整数计数（最大余数法，和恰为 n）。""" 60	    counts = {sym: int(f * n) for sym, f in fractions.items()} 61	    rest = n - sum(counts.values()) 62	    order = sorted(fractions, key=lambda s: (fractions[s] * n - counts[s]), reverse=True) 63	    for i in range(rest): 64	        counts[order[i % len(order)]] += 1 65	    return counts 66	 67	 68	def build_doped_structure(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 69	    """按组分在原型上替换 TM 位点 → (结构, 实现计数, TM 位点下标列表)。 70	 71	    原型分派（T9-new 跨家族扩展）： 72	    - 含 P（含或不含 F）→ 橄榄石 Pnma（LFP 标准坐标；含 F 的氟盐类同近似，如实标注） 73	    - TM 计数总和 = 2（M2O4 型）→ 尖晶石 Fd-3m（LMO 标准坐标） 74	    - 其余（默认）→ 层状 R-3m（原有路径，完全不变） 75	    """ 76	    comp = Composition(formula) 77	    symbols = set(map(str, comp.keys())) 78	    if "P" in symbols: 79	        return _build_olivine(formula) 80	    tm_count = {str(k): float(v) for k, v in comp.items() if str(k) not in ("Li", "O")} 81	    if abs(sum(tm_count.values()) - 2.0) < 1e-6: 82	        return _build_spinel(formula) 83	    tm = _tm_fractions(formula) 84	    struct = _base_structure() 85	    tm_sites = [ 86	        i for i, site in enumerate(struct) if site.specie.symbol not in ("Li", "O") 87	    ] 88	    counts = _largest_remainder(tm, len(tm_sites)) 89	    rng = np.random.default_rng(_seed(formula)) 90	    order = rng.permutation(len(tm_sites)) 91	    assignment: list[str] = [] 92	    for sym, k in counts.items(): 93	        assignment += [sym] * k 94	    rng.shuffle(assignment) 95	    for pos, sym in zip(order, assignment): 96	        struct.replace(tm_sites[pos], sym) 97	    return struct, counts, tm_sites 98	 99	 100	def _build_olivine(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 101	    """橄榄石 Pnma（LiFePO4 标准参数：a=10.332 b=6.010 c=4.694 Å）。 102	    代表坐标