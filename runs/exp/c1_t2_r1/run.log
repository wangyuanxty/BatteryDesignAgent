```python
import json, os, subprocess, sys

WS = r'...c1_t2_r1'
PY = r'...\.venv\Scripts\python.exe'
CLI = r'...\slim_bda.py'

def run(args, timeout=1800):
    r = subprocess.run([PY, CLI]+args, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        tail = (r.stdout + r.stderr)[-800:]
        raise RuntimeError('FAILED %s:\n%s' % (' '.join(args), tail))
    return r

def jload(p):
    return json.load(open(p, encoding='utf-8'))

def eval_design(tag, params, aging_cycles=None, aging_protocol='aging_1C_100cyc'):
    pp = os.path.join(WS, 'd_%s_p.json' % tag)
    json.dump(params, open(pp,'w'))
    m = {'tag': tag}
    try:
        run(['run-pyamm','--params',pp,'--protocol','1C_discharge','--out', os.path.join(WS,'d_%s_d1c.json'%tag)])
        d1c = jload(os.path.join(WS,'d_%s_d1c.json'%tag))
        m['cap1c'] = d1c['capacity_ah']
        run(['run-pyamm','--params',pp,'--protocol','lowT_discharge','--out', os.path.join(WS,'d_%s_dlt.json'%tag)])
        dlt = jload(os.path.join(WS,'d_%s_dlt.json'%tag))
        m['caplt'] = dlt['capacity_ah']
        m['retention'] = dlt['capacity_ah']/d1c['capacity_ah']
        run(['run-pyamm','--params',pp,'--protocol','4C_charge_45C','--plating','--out', os.path.join(WS,'d_%s_c4c.json'%tag)])
        c4 = jload(os.path.join(WS,'d_%s_c4c.json'%tag))
        m['min_ap'] = min(c4['anode_potential_v'])
        run(['calc-energy','--params',pp,'--sim', os.path.join(WS,'d_%s_d1c.json'%tag),'--out', os.path.join(WS,'d_%s_e.json'%tag)])
        e = jload(os.path.join(WS,'d_%s_e.json'%tag))
        m['E'] = e['energy_density_wh_kg']
        if aging_cycles:
            extra = ['--cycles', str(aging_cycles)]
            run(['run-pyamm','--params',pp,'--protocol',aging_protocol]+extra+'--out', ...)
        ...
    except Exception as ex:
        m['error'] = str(ex)[:500]
    return m
```

