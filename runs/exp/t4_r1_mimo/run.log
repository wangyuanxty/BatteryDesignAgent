无法判定的形态一律不过（宁可 fail 不可假 pass） 108	 109	 110	def check_against_criteria(metrics: dict[str, tuple], thresholds: dict, base: Path) -> tuple[list, list]: 111	    """→ (evidence 列表, unchecked 键列表)。evidence 指向文件:键，判定结果由代码给出。 112	 113	    base = case 目录：来源路径相对化（审计日志跨机器可重放，不嵌绝对路径）。 114	    """ 115	    evidence: list[dict] = [] 116	    unchecked: list[str] = [] 117	    for key, threshold in thresholds.items(): 118	        if key not in metrics: 119	            unchecked.append(key) 120	            continue 121	        value, src = metrics[key] 122	        source = f"{_rel_to(src, base)}:{key}" 123	        if key == "plated" and "_plated_note" in metrics: 124	            note, _ = metrics["_plated_note"] 125	            source = f"{_rel_to(src, base)}:{note}" 126	        ok = _threshold_ok(value, threshold) 127	        evidence.append( 128	            { 129	                "metric": key, 130	                "value": value, 131	                "threshold": threshold, 132	                "verdict": "pass" if ok else "fail", 133	                "source": source, 134	            } 135	        ) 136	    return evidence, unchecked 137	 138	 139	def _evaluate_one(case_dir: Path, records: list, candidate: str, outputs: list[str], note: str) -> dict: 140	    """单个候选评估（内部共用）：读输出文件 → 机械判定 → 返回条目（不落盘）。""" 141	    thresholds = None  # 每候选共享同轮 criteria，由调用方传入（见 _evaluate_record） 142	 143	    files: list[Path] = [] 144	    for arg in outputs: 145	        p = None 146	        for cand in (case_dir / arg, REPO_ROOT / arg, Path(arg)): 147	            if cand.exists() and cand.is_file(): 148	                p = cand 149	                break 150	        if p is None: 151	            raise RuntimeError(f"输出文件不存在：{arg}") 152	        files.append(p) 153	    if not files: 154	        raise RuntimeError("无有效输出文件") 155	    metrics = extract_metrics(files) 156	    evidence, unchecked = check_against_criteria(metrics, dict(records), base=case_dir) 157	    if not evidence: 158	        raise RuntimeError