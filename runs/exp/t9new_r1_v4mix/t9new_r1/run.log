[tool_result]1	"""电极组分候选筛选（run-comp）：NMC811 层状原型 + 位点替换 → CHGNet 弛豫（满锂/去锂两态） 2	→ 相对稳定性 + 平均电压 + 容量代理。 3	 4	口径（如实声明）： 5	- 结构：NMC811 层状 R-3m 原型（六方 a≈2.87 Å, c≈14.19 Å；Li 3b / TM 3a / O 6c z≈0.241）， 6	  4×4×1 超胞（64 原子、16 个 TM 位点）；掺杂组分按最大余数法取整，实际实现组分写入输出。 7	- 能量/电压：CHGNet 代理（筛选口径，误差 0.1-0.3 V 量级）；周期 DFT 真背书缺工具（如实标注）。 8	- 去锂态：x_Li=0.3 随机去锂（种子由 formula 哈希决定，可复现）。 9	""" 10	 11	import hashlib 12	import json 13	 14	import numpy as np 15	from pymatgen.core import Composition, Lattice, Structure 16	 17	_A, _C, _O_Z = 2.87, 14.19, 0.241  # NMC811 层状 R-3m 文献晶格参数 18	_SUPERCELL = (2, 2, 1) 19	_X_FULL, _X_DELITH = 1.0, 0.3  # 满锂 / 去锂态的 Li 占位 20	_F = 26801.481  # 法拉第常数折算：F/3.6 (mAh·mol⁻¹) 21	 22	NMC_BASE_FORMULA = "Li(Ni0.8Mn0.1Co0.1)O2" 23	 24	 25	def _seed(formula: str) -> int: 26	    return int(hashlib.sha256(formula.encode("utf-8")).hexdigest()[:8], 16) 27	 28	 29	def _base_structure() -> Structure: 30	    """NMC811 层状 R-3m 原型 2×2×1 超胞（每六方晶胞 3 个化学式单元 = 12 原子； 31	    超胞 48 原子：12 Li / 12 TM / 24 O）。Wyckoff 位点： 32	    Li 3b (0,0,1/2)(1/3,2/3,5/6)(2/3,1/3,1/6)；TM 3a (0,0,0)(1/3,2/3,1/3)(2/3,1/3,2/3)； 33	    O 6c (0,0,±z)(1/3,2/3,1/3±z)(2/3,1/3,2/3±z)。""" 34	    li = [[0, 0, 0.5], [1 / 3, 2 / 3, 5 / 6], [2 / 3, 1 / 3, 1 / 6]] 35	    tm = [[0, 0, 0], [1 / 3, 2 / 3, 1 / 3], [2 / 3, 1 / 3, 2 / 3]] 36	    o = [ 37	        [0, 0, _O_Z], [0, 0, 1 - _O_Z], 38	        [1 / 3, 2 / 3, 1 / 3 + _O_Z], [1 / 3, 2 / 3, 1 / 3 - _O_Z], 39	        [2 / 3, 1 / 3, 2 / 3 + _O_Z], [2 / 3, 1 / 3, 2 / 3 - _O_Z], 40	    ] 41	    lat = Lattice.hexagonal(_A, _C) 42	    struct = Structure(lat, ["Li"] * 3 + ["Ni"] * 3 + ["O"] * 6, li + tm + o) 43	    struct.make_supercell(_SUPERCELL) 44	    return struct 45	 46	 47	def _tm_fractions(formula: str) -> dict[str, float]: 48	    comp = Composition(formula) 49	    tm = {str(k): float(v) for k, v in comp.items() if str(k) not in ("Li", "O")} 50	    if not tm: 51	        raise ValueError(f"no transition-metal species in formula: {formula}") 52	    total = sum(tm.values()) 53	    if abs(total - 1.0) > 1e-6: 54	        raise ValueError(f"TM fractions must sum to 1; got {tm} (sum={total})") 55	    return tm 56	 57	 58	def _largest_remainder(fractions: dict[str, float], n: int) -> dict[str, int]: 59	    """组分分数 → 整数计数（最大余数法，和恰为 n）。""" 60	    counts = {sym: int(f * n) for sym, f in fractions.items()} 61	    rest = n - sum(counts.values()) 62	    order = sorted(fractions, key=lambda s: (fractions[s] * n - counts[s]), reverse=True) 63	    for i in range(rest): 64	        counts[order[i % len(order)]] += 1 65	    return counts 66	 67	 68	def build_doped_structure(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 69	    """按组分在原型上替换 TM 位点 → (结构, 实现计数, TM 位点下标列表)。 70	 71	    原型分派（T9-new 跨家族扩展）： 72	    - 含 P（含或不含 F）→ 橄榄石 Pnma（LFP 标准坐标；含 F 的氟盐类同近似，如实标注） 73	    - TM 计数总和 = 2（M2O4 型）→ 尖晶石 Fd-3m（LMO 标准坐标） 74	    - 其余（默认）→ 层状 R-3m（原有路径，完全不变） 75	    """ 76	    comp = Composition(formula) 77	    symbols = set(map(str, comp.keys())) 78	    if "P" in symbols: 79	        return _build_olivine(formula) 80	    tm_count = {str(k): float(v) for k, v in comp.items() if str(k) not in ("Li", "O")} 81	    if abs(sum(tm_count.values()) - 2.0) < 1e-6: 82	        return _build_spinel(formula) 83	    tm = _tm_fractions(formula) 84	    struct = _base_structure() 85	    tm_sites = [ 86	        i for i, site in enumerate(struct) if site.specie.symbol not in ("Li", "O") 87	    ] 88	    counts = _largest_remainder(tm, len(tm_sites)) 89	    rng = np.random.default_rng(_seed(formula)) 90	    order = rng.permutation(len(tm_sites)) 91	    assignment: list[str] = [] 92	    for sym, k in counts.items(): 93	        assignment += [sym] * k 94	    rng.shuffle(assignment) 95	    for pos, sym in zip(order, assignment): 96	        struct.replace(tm_sites[pos], sym) 97	    return struct, counts, tm_sites 98	 99	 100	def _build_olivine(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 101	    """橄榄石 Pnma（LiFePO4 标准参数：a=10.332 b=6.010 c=4.694 Å）。 102	    代表坐标（Wyckoff）：Li 4a (0,0,0)；M 4c (0.218,0.25,0.202)； 103	    P 4c (0.0946,0.25,0.0619)；O 4c×2 + 8d → 28 原子原始胞（from_spacegroup 生成）。""" 104	    struct = Structure.from_spacegroup( 105	        "Pnma", 106	        Lattice.orthorhombic(10.332, 6.010, 4.694), 107	        ["Li", "M", "P", "O", "O", "O"], 108	        [[0, 0, 0], 109	         [0.218, 0.25, 0.202], 110	         [0.0946, 0.25, 0.0619], 111	         [0.0984, 0.25, 0.7427], 112	         [0.0450, 0.25, 0.2849], 113	         [0.0859, 0.0358, 0.5330]], 114	    ) 115	    tm_sites = [i for i, site in enumerate(struct) if site.specie.symbol == "M"] 116	    tm = {str(k): float(v) for k, v in Composition(formula).items() 117	          if str(k) not in ("Li", "O", "P", "Si", "F")} 118	    total = sum(tm.values()) 119	    tm = {k: v / total for k, v in tm.items()}  # 归一化（橄榄石 M 位 =1.0） 120	    counts = _largest_remainder(tm, len(tm_sites)) 121	    rng = np.random.default_rng(_seed(formula)) 122	    order = rng.permutation(len(tm_sites)) 123	    assignment: list[str] = [] 124	    for sym, k in counts.items(): 125	        assignment += [sym] * k 126	    rng.shuffle(assignment) 127	    for pos, sym in zip(order, assignment): 128	        struct.replace(tm_sites[pos], sym) 129	    return struct, counts, tm_sites 130	 131	 132	def _build_spinel(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 133	    """尖晶石 Fd-3m（LiMn2O4：a=8.247 Å；Li 8a、M 16d、O 32e x=0.263 → 134	    56 原子原始胞，from_spacegroup 生成）。""" 135	    struct = Structure.from_spacegroup( 136	        "Fd-3m", 137	        Lattice.cubic(8.247), 138	        ["Li", "M", "O"], 139	        [[0.125, 0.125, 0.125], 140	         [0.5, 0.5, 0.5], 141	         [0.263, 0.263, 0.263]], 142	    ) 143	    tm_sites = [i for i, site in enumerate(struct) if site.specie.symbol == "M"] 144	    tm = {str(k): float(v) for k, v in Composition(formula).items() 145	          if str(k) not in ("Li", "O")} 146	    total = sum(tm.values()) 147	    tm = {k: v / total for k, v in tm.items()}  # 归一化（尖晶石 M 位 1.5-2.0 比例） 148	    counts = _largest_remainder(tm, len(tm_sites)) 149	    rng = np.random.default_rng(_seed(formula)) 150	    order = rng.permutation(len(tm_sites)) 151	    assignment: list[str] = [] 152	    for sym, k in counts.items(): 153	        assignment += [sym] * k 154	    rng.shuffle(assignment) 155	    for pos, sym in zip(order, assignment): 156	        struct.replace(tm_sites[pos], sym) 157	    return struct, counts, tm_sites 158	 159	 160	def delithiate(struct: Structure, x_li: float, seed: int) -> tuple[Structure, int]: 161	    """随机去锂至 x_li 占位（种子可复现）→ (结构, 保留 Li 数)。""" 162	    li_sites = [i for i, site in enumerate(struct) if site.specie.symbol == "Li"] 163	    keep = int(round(x_li * len(li_sites))) 164	    rng = np.random.default_rng(seed) 165	    drop = rng.choice(li_sites, size=len(li_sites) - keep, replace=False) 166	    struct.remove_sites(drop) 167	    return struct, keep 168	 169	 170	def relax_energy(struct: Structure) -> tuple[float, bool]: 171	    """CHGNet 原生 StructOptimizer（FIRE）+ GPU 弛豫 → (能量 eV, 是否收敛)。""" 172	    from chgnet.model import CHGNet 173	    from chgnet.model.dynamics import AseAtomsAdaptor 174	    from chgnet.model.dynamics import FIRE 175	    from chgnet.model.dynamics import StructOptimizer 176	 177	    atoms = AseAtomsAdaptor().get_atoms(struct) 178	    relaxer = StructOptimizer(model=CHGNet.load(), optimizer_class=FIRE) 179	    result = relaxer.relax(atoms, fmax=0.1, steps=300, relax_cell=True, verbose=False) 180	    traj = result.get("trajectory") 181	    # chgnet 0.4.x：TrajectoryObserver 对象（.trajectory 帧列表）或帧列表 182	    frames = getattr(traj, "trajectory", None) or (traj if isinstance(traj, list) else []) 183	    if not frames: 184	        return float(atoms.get_potential_energy()), False 185	    last = frames[-1] 186	    energy = last.get("energies", last.get("energy")) 187	    if isinstance(energy, (list, tuple)): 188	        energy = energy[-1] if energy else None 189	    forces = last.get("forces", last.get("force")) 190	    if isinstance(forces, (list, tuple)): 191	        forces = forces[-1] if forces else None 192	    fmax = float(np.abs(np.asarray(forces)).max()) if forces is not None else None 193	    converged = bool(energy is not None and fmax is not None and fmax <= 0.1) 194	    return float(energy), converged 195	 196	 197	def _n_fu(formula: str) -> int: 198	    """超胞所含化学式单元数（按 Li 数定：满锂态 Li 数 = 12 → n_fu = 12/1）。""" 199	    return 12  # 2×2×1 超胞：12 个 Li 200	 201	 202	def average_voltage(e_full: float, e_delith: float, n_removed: int, e_li: float) -> float: 203	    """平均电压（vs Li 金属）：V = −[E(Li_x2) − E(Li_x1) − n_removed·E_Li] / n_removed。""" 204	    if n_removed <= 0: 205	        raise ValueError("n_removed must be positive") 206	    return -(e_full - e_delith - n_removed * e_li) / n_removed 207	 208	 209	def screen_candidate(formula: str, base_energy_fu: float | None, e_li: float) -> dict: 210	    """单个组分候选：满锂/去锂弛豫 → 相对稳定性 + 平均电压 + 容量代理。 211	 212	    平均电压（vs Li 金属）：V = −[E(Li_x2MO2) − E(Li_x1MO2) − n_removed·E_Li] / n_removed 213	    （E_Li 为 CHGNet 的 bcc Li 金属参考能量，每轮基线计算一次）。 214	    """ 215	    struct_full, counts, _ = build_doped_structure(formula) 216	    seed = _seed(formula) 217	    e_full, conv_full = relax_energy(struct_full) 218	    n_li_full = sum(1 for s in struct_full if s.specie.symbol == "Li") 219	    struct_delith, n_li_delith = delithiate(struct_full, _X_DELITH, seed) 220	    e_delith, conv_delith = relax_energy(struct_delith) 221	    n_removed = n_li_full - n_li_delith 222	    avg_voltage = average_voltage(e_full, e_delith, n_removed, e_li) 223	    mw = Composition(formula).weight  # g/mol 224	    capacity_mah_g = (_X_FULL - _X_DELITH) * _F / mw 225	    n_atoms = len(struct_full) 226	    out = { 227	        "formula": formula, 228	        "realized_tm_counts": counts, 229	        "avg_voltage_v": float(avg_voltage), 230	        "capacity_mah_g": float(capacity_mah_g), 231	        "e_full_ev": e_full, 232	        "e_delith_ev": e_delith, 233	        "converged": bool(conv_full and conv_delith), 234	        "rel_stability_ev_atom": ( 235	            float((e_full / n_atoms) - (base_energy_fu / 4.0)) 236	            if base_energy_fu is not None 237	            else None 238	        ), 239	    } 240	    return out 241	 242	 243	def _li_metal_energy() -> float: 244	    """bcc Li 金属参考能量（每原子 eV，CHGNet 弛豫 2 原子胞）。""" 245	    from pymatgen.core import Lattice as _Lattice 246	 247	    li = Structure(_Lattice.cubic(3.51), ["Li", "Li"], [[0, 0, 0], [0.5, 0.5, 0.5]]) 248	    e, _conv = relax_energy(li) 249	    return e / 2.0 250	 251	 252	def run_composition_screen(in_data: dict) -> dict: 253	    """IN: {"candidates": [{"formula": "...", "name": "..."}]} → OUT: 每候选 metrics + 基线。""" 254	    cands = in_data.get("candidates", []) 255	    if not cands: 256	        raise ValueError("input must contain a non-empty 'candidates' list") 257	    base_e_fu = None 258	    # 基线 NMC811 + bcc Li 金属参考能量 259	    base_struct, _, _ = build_doped_structure(NMC_BASE_FORMULA) 260	    e_base, conv_base = relax_energy(base_struct) 261	    base_e_fu = e_base / _n_fu(NMC_BASE_FORMULA) 262	    e_li = _li_metal_energy() 263	    results = [] 264	    for c in cands: 265	        formula = str(c.get("formula") or "") 266	        name = str(c.get("name") or formula) 267	        try: 268	            m = screen_candidate(formula, base_e_fu, e_li) 269	            m["name"] = name 270	            results.append(m) 271	        except ValueError as exc: 272	            results.append({"name": name, "formula": formula, "error": str(exc)}) 273	    return { 274	        "baseline": { 275	            "formula": NMC_BASE_FORMULA, 276	            "e_full_ev": e_base, 277	            "e_li_metal_ev": e_li, 278	            "converged": bool(conv_base), 279	        }, 280	        "candidates": results, 281	        "calibration_note": ( 282	            "NMC811 基线自校准：文献平均电压 ≈3.8 V、理论容量 ≈194 mAh/g（x∈[0.3,1] 窗口）" 283	            "——若基线预测显著偏离，说明本批结果不可信（如实标注）。" 284	    