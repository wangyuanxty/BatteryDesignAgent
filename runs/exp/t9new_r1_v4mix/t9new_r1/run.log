[tool_result]1	"""周期 DFT 真背书（run-qe）：组分 → QE vc-relax → 相对稳定性 + 平均电压（含 QE Li 金属参考）。 2	 3	环境：pw.x（conda-forge q-e 包）+ SSSP efficiency 赝势（conda-forge sssp 包）。 4	口径： 5	- ecutwfc=50 Ry / ecutrho=400 Ry（SSSP efficiency 标准）；nspin=2（Ni/Mn/Co 磁性，铁磁初猜）； 6	- 满锂态 vc-relax（晶胞+离子）；去锂态固定弛豫后晶胞、仅离子 relax（节省成本，如实标注）； 7	- 电压公式与 run-comp 一致：V = −[E_full − E_delith − n_removed·E_Li]/n_removed。 8	- 运行时间：12 原子原胞 ~1 小时/态；48 原子超胞小时级（CPU 挂夜）。 9	""" 10	 11	import os 12	import shutil 13	import subprocess 14	import time 15	 16	from pymatgen.core import Lattice, Structure 17	 18	# 赝势探测顺序：环境变量 > py312 conda 环境 sssp 目录 19	_PSEUDO_CANDIDATES = [ 20	    os.environ.get("QE_PSEUDO_DIR"), 21	    r"D:\anaconda\envs\py312\share\sssp\efficiency", 22	    r"D:\anaconda\share\sssp\efficiency", 23	] 24	 25	# SSSP efficiency 赝势文件名（本案例元素；缺失元素报错提示） 26	_PSEUDO_FILES = { 27	    "Li": "li_pbe_v1.4.uspp.F.UPF", 28	    "Ni": "ni_pbe_v1.4.uspp.F.UPF", 29	    "Mn": "mn_pbe_v1.5.uspp.F.UPF", 30	    "Co": "Co_pbe_v1.2.uspp.F.UPF", 31	    "O": "O.pbe-n-kjpaw_psl.0.1.UPF", 32	    "P": "P.pbe-n-rrkjus_psl.1.0.0.UPF", 33	    "Si": "Si.pbe-n-rrkjus_psl.1.0.0.UPF", 34	    "Mg": "Mg.pbe-n-kjpaw_psl.0.3.0.UPF", 35	} 36	 37	_MAGNETIC = {"Ni", "Mn", "Co"}  # 需要 nspin=2 与初始磁矩的元素 38	 39	 40	def pseudo_dir() -> str: 41	    for cand in _PSEUDO_CANDIDATES: 42	        if cand and os.path.isdir(cand): 43	            return cand 44	    raise RuntimeError( 45	        "QE pseudopotential dir not found; set QE_PSEUDO_DIR or install conda-forge 'sssp' package" 46	    ) 47	 48	 49	def pw_bin() -> str: 50	    for name in ("pw.x", "pw.exe", "pw.x.exe"):  # MSYS2 包内为 pw.exe 51	        found = shutil.which(name) 52	        if found: 53	            return found 54	    for cand in ( 55	        # MSYS2 原版 pw.exe 栈保留仅 2MB（计算初始化即栈溢出 0xC00000FD）； 56	        # pw_stack4g.exe = pefile 打过补丁的副本（栈保留 4GB），优先使用 57	        r"C:\msys64\ucrt64\bin\pw_stack4g.exe", 58	        r"C:\msys64\ucrt64\bin\pw.exe",  # MSYS2 mingw-w64-ucrt-x86_64-quantum-espresso 59	        r"C:\msys64\mingw64\bin\pw.x.exe", 60	        r"D:\anaconda\envs\py312\Library\bin\pw.x", 61	        r"D:\anaconda\Library\bin\pw.x", 62	    ): 63	        if os.path.isfile(cand): 64	            return cand 65	    raise RuntimeError( 66	        "pw.x not found; install MSYS2 quantum-espresso: " 67	        "winget install MSYS2.MSYS2 && pacman -S mingw-w64-ucrt-x86_64-quantum-espresso" 68	    ) 69	 70	 71	def _magnetization(structure: Structure) -> dict[str, float]: 72	    """磁性元素初始磁矩（铁磁初猜，筛选口径）。""" 73	    return {el: 0.6 for el in {s.specie.symbol for s in structure} if el in _MAGNETIC} 74	 75	 76	def write_inputs(structure: Structure, workdir: str, prefix: str, relax_cell: bool) -> None: 77	    """pymatgen → pw.x 输入文件（vc-relax 或 relax）。""" 78	    from pymatgen.io.pwscf import PWInput 79	 80	    pseudo = {} 81	    for el in {s.specie.symbol for s in structure}: 82	        if el not in _PSEUDO_FILES: 83	            raise ValueError(f"no SSSP efficiency pseudopotential entry for element {el}") 84	        pseudo[el] = _PSEUDO_FILES[el] 85	    mag = _magnetization(structure) 86	    control = { 87	        "calculation": "vc-relax" if relax_cell else "relax", 88	        "prefix": prefix, 89	        "pseudo_dir": pseudo_dir(), 90	        "outdir": os.path.join(workdir, "out"), 91	        "tstress": relax_cell, 92	        "tprnfor": True, 93	        "etot_conv_thr": 1.0e-4, 94	        "forc_conv_thr": 1.0e-3, 95	        "nstep": 60, 96	        "verbosity": "low", 97	    } 98	    system = { 99	        "ecutwfc": 50.0, 100	        "ecutrho": 400.0, 101	        "occupations": "smearing", 102	        "degauss": 0.02, 103	    } 104	    if mag: 105	        system["nspin"] = 2 106	        # QE 的 namelist 不支持 dict——统一标量初猜（全部元素 0.6，仅初始猜测） 107	        system["starting_magnetization"] = 0.6 108	    electrons = {"conv_thr": 1.0e-7, "mixing_beta": 0.3} 109	    pw = PWInput(structure, pseudo=pseudo, control=control, system=system, electrons=electrons) 110	    os.makedirs(workdir, exist_ok=True) 111	    in_path = os.path.join(workdir, f"{prefix}.in") 112	    pw.write_file(in_path) 113	    # Fortran namelist 里反斜杠是转义符：Windows 路径必须换成正斜杠（否则 pw.x 静默崩溃） 114	    text = open(in_path, encoding="utf-8").read().replace("\\", "/") 115	    open(in_path, "w", encoding="utf-8").write(text) 116	 117	 118	def parse_pw_output(text: str) -> tuple[float, bool]: 119	    """pw.x stdout → (总能量 eV, 收敛)。""" 120	    energies = [ 121	        float(line.split()[-2]) 122	        for line in text.splitlines() 123	        if line.strip().startswith("!") 124	    ] 125	    if not energies: 126	        raise RuntimeError("pw.x produced no total energy") 127	    converged = "convergence has been achieved" in text or "End final coordinates" in text 128	    return energies[-1] * 13.605703976, converged  # Ry → eV 129	 130	 131	def run_pw(workdir: str, prefix: str) -> tuple[float, bool, float]: 132	    """执行 pw.x → (总能量 eV, 收敛, 耗时秒)。""" 133	    t0 = time.time() 134	    in_file = os.path.join(workdir, f"{prefix}.in") 135	    out_file = os.path.join(workdir, f"{prefix}.out") 136	    env = dict(os.environ) 137	    # MSYS2 的 pw.exe 需要 ucrt64\bin 下的运行时 DLL（libgcc/libgfortran/MPI 等） 138	    env["PATH"] = os.path.dirname(pw_bin()) + os.pathsep + env.get("PATH", "") 139	    with open(out_file, "w", encoding="utf-8") as out: 140	        subprocess.run([pw_bin(), "-in", in_file], stdout=out, stderr=subprocess.STDOUT, check=False, env=env) 141	    wall = time.time() - t0 142	    text = open(out_file, encoding="utf-8", errors="replace").read() 143	    energy, converged = parse_pw_output(text) 144	    if not converged and "!" not in text: 145	        raise RuntimeError(f"pw.x produced no total energy for {prefix}; see {out_file}") 146	    return energy, converged, wall 147	 148	 149	def qe_endorsement(formula: str, delith_frac: float = 0.3) -> dict: 150	    """单个组分周期 DFT 背书：满锂 vc-relax + 去锂 relax + Li 金属参考 → 电压。""" 151	    import tempfile 152	 153	    from bda.simulators.comp_runner import ( 154	        _seed, 155	        average_voltage, 156	        build_doped_structure, 157	        delithiate, 158	    ) 159	 160	    workdir = tempfile.mkdtemp(prefix="bda_qe_") 161	    try: 162	        struct_full, counts, _ = build_doped_structure(formula) 163	        n_li_full = sum(1 for s in struct_full if s.specie.symbol == "Li") 164	        write_inputs(struct_full, workdir, "full", relax_cell=True) 165	        e_full, conv_full, t_full = run_pw(workdir, "full") 166	        struct_delith, n_li_delith = delithiate(struct_full, delith_frac, _seed(formula)) 167	        write_inputs(struct_delith, workdir, "delith", relax_cell=False) 168	        e_delith, conv_delith, t_delith = run_pw(workdir, "delith") 169	        li = Structure(Lattice.cubic(3.51), ["Li", "Li"], [[0, 0, 0], [0.5, 0.5, 0.5]]) 170	        write_inputs(li, workdir, "li", relax_cell=True) 171	        e_li_cell, conv_li, t_li = run_pw(workdir, "li") 172	        e_li = e_li_cell / 2.0 173	        n_removed = n_li_full - n_li_delith 174	        voltage = average_voltage(e_full, e_delith, n_removed, e_li) 175	        return { 176	            "formula": formula, 177	            "realized_tm_counts": counts, 178	            "avg_voltage_v": float(voltage), 179	            "e_full_ev": e_full, 180	            "e_delith_ev": e_delith, 181	            "e_li_metal_ev": e_li, 182	            "converged": bool(conv_full and conv_delith and conv_li), 183	            "wall_time_s": t_full + t_delith + t_li, 184	        } 185	    finally: 186	        shutil.rmtree(workdir, ignore_errors=True) 187	 188	 189	def run_qe_endorsement(in_data: dict) -> dict: 190	    """IN: {"candidates": [{"formula", "name"}]} → OUT: 每候选周期 DFT 背书（含 NMC811 基线）。""" 191	    cands = in_data.get("candidates", []) 192	    if not cands: 193	        raise ValueError("input must contain a non-empty 'candidates' list") 194	    results = [] 195	    for c in cands: 196	        formula = str(c.get("formula") or "") 197	        name = str(c.get("name") or