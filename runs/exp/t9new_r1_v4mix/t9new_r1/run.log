[tool_result]1	"""电极组分候选筛选（run-comp）：NMC811 层状原型 + 位点替换 → CHGNet 弛豫（满锂/去锂两态） 2	→ 相对稳定性 + 平均电压 + 容量代理。 3	 4	口径（如实声明）： 5	- 结构：NMC811 层状 R-3m 原型（六方 a≈2.87 Å, c≈14.19 Å；Li 3b / TM 3a / O 6c z≈0.241）， 6	  4×4×1 超胞（64 原子、16 个 TM 位点）；掺杂组分按最大余数法取整，实际实现组分写入输出。 7	- 能量/电压：CHGNet 代理（筛选口径，误差 0.1-0.3 V 量级）；周期 DFT 真背书缺工具（如实标注）。 8	- 去锂态：x_Li=0.3 随机去锂（种子由 formula 哈希决定，可复现）。 9	""" 10	 11	import hashlib 12	import json 13	 14	import numpy as np 15	from pymatgen.core import Composition, Lattice, Structure 16	 17	_A, _C, _O_Z = 2.87, 14.19, 0.241  # NMC811 层状 R-3m 文献晶格参数 18	_SUPERCELL = (2, 2, 1) 19	_X_FULL, _X_DELITH = 1.0, 0.3  # 满锂 / 去锂态的 Li 占位 20	_F = 26801.481  # 法拉第常数折算：F/3.6 (mAh·mol⁻¹) 21	 22	NMC_BASE_FORMULA = "Li(Ni0.8Mn0.1Co0.1)O2" 23	 24	 25	def _seed(formula: str) -> int: 26	    return int(hashlib.sha256(formula.encode("utf-8")).hexdigest()[:8], 16) 27	 28	 29	def _base_structure() -> Structure: 30	    """NMC811 层状 R-3m 原型 2×2×1 超胞（每六方晶胞 3 个化学式单元 = 12 原子； 31	    超胞 48 原子：12 Li / 12 TM / 24 O）。Wyckoff 位点： 32	    Li 3b (0,0,1/2)(1/3,2/3,5/6)(2/3,1/3,1/6)；TM 3a (0,0,0)(1/3,2/3,1/3)(2/3,1/3,2/3)； 33	    O 6c (0,0,±z)(1/3,2/3,1/3±z)(2/3,1/3,2/3±z)。""" 34	    li = [[0, 0, 0.5], [1 / 3, 2 / 3, 5 / 6], [2 / 3, 1 / 3, 1 / 6]] 35	    tm = [[0, 0, 0], [1 / 3, 2 / 3, 1 / 3], [2 / 3, 1 / 3, 2 / 3]] 36	    o = [ 37	        [0, 0, _O_Z], [0, 0, 1 - _O_Z], 38	        [1 / 3, 2 / 3, 1 / 3 + _O_Z], [1 / 3, 2 / 3, 1 / 3 - _O_Z], 39	        [2 / 3, 1 / 3, 2 / 3 + _O_Z], [2 / 3, 1 / 3, 2 / 3 - _O_Z], 40	    ] 41	    lat = Lattice.hexagonal(_A, _C) 42	    struct = Structure(lat, ["Li"] * 3 + ["Ni"] * 3 + ["O"] * 6, li + tm + o) 43	    struct.make_supercell(_SUPERCELL) 44	    return struct 45	 46	 47	def _tm_fractions(formula: str) -> dict[str, float]: 48	    comp = Composition(formula) 49	    tm = {str(k): float(v) for k, v in comp.items() if str(k) not in ("Li", "O")} 50	    if not tm: 51	        raise ValueError(f"no transition-metal species in formula: {formula}") 52	    total = sum(tm.values()) 53	    if abs(total - 1.0) > 1e-6: 54	        raise ValueError(f"TM fractions must sum to 1; got {tm} (sum={total})") 55	    return tm 56	 57	 58	def _largest_remainder(fractions: dict[str, float], n: int) -> dict[str, int]: 59	    """组分分数 → 整数计数（最大余数法，和恰为 n）。""" 60	    counts = {sym: int(f * n) for sym, f in fractions.items()} 61	    rest = n - sum(counts.values()) 62	    order = sorted(fractions, key=lambda s: (fractions[s] * n - counts[s]), reverse=True) 63	    for i in range(rest): 64	        counts[order[i % len(order)]] += 1 65	    return counts 66	 67	 68	def build_doped_structure(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 69	    """按组分在原型上替换 TM 位点 → (结构, 实现计数, TM 位点下标列表)。 70	 71	    原型分派（T9-new 跨家族扩展）： 72	    - 含 P（含或不含 F）→ 橄榄石 Pnma（LFP 标准坐标；含 F 的氟盐类同近似，如实标注） 73	    - TM 计数总和 = 2（M2O4 型）→ 尖晶石 Fd-3m（LMO 标准坐标） 74	    - 其余（默认）→ 层状 R-3m（原有路径，完全不变） 75	    """ 76	    comp = Composition(formula) 77	    symbols = set(map(str, comp.keys())) 78	    if "P" in symbols: 79	        return _build_olivine(formula) 80	    tm_count = {str(k): float(v) for k, v in comp.items() if str(k) not in ("Li", "O")} 81	    if abs(sum(tm_count.values()) - 2.0) < 1e-6: 82	        return _build_spinel(formula) 83	    tm = _tm_fractions(formula) 84	    struct = _base_structure() 85	    tm_sites = [ 86	        i for i, site in enumerate(struct) if site.specie.symbol not in ("Li", "O") 87	    ] 88	    counts = _largest_remainder(tm, len(tm_sites)) 89	    rng = np.random.default_rng(_seed(formula)) 90	    order = rng.permutation(len(tm_sites)) 91	    assignment: list[str] = [] 92	    for sym, k in counts.items(): 93	        assignment += [sym] * k 94	    rng.shuffle(assignment) 95	    for pos, sym in zip(order, assignment): 96	        struct.replace(tm_sites[pos], sym) 97	    return struct, counts, tm_sites 98	 99	 100	def _build_olivine(formula: str) -> tuple[Structure, dict[str, int], list[int]]: 101	    """橄榄石 Pnma（LiFePO4 标准参数：a=10.332 b=6.010 c=4.694 Å）。 102	    代表坐标