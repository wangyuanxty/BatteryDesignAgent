t_ok=True) 111	    in_path = os.path.join(workdir, f"{prefix}.in") 112	    pw.write_file(in_path) 113	    # Fortran namelist 里反斜杠是转义符：Windows 路径必须换成正斜杠（否则 pw.x 静默崩溃） 114	    text = open(in_path, encoding="utf-8").read().replace("\\", "/") 115	    open(in_path, "w", encoding="utf-8").write(text) 116	 117	 118	def parse_pw_output(text: str) -> tuple[float, bool]: 119	    """pw.x stdout → (总能量 eV, 收敛)。""" 120	    energies = [ 121	        float(line.split()[-2]) 122	        for line in text.splitlines() 123	        if line.strip().startswith("!") 124	    ] 125	    if not energies: 126	        raise RuntimeError("pw.x produced no total energy") 127	    converged = "convergence has been achieved" in text or "End final coordinates" in text 128	    return energies[-1] * 13.605703976, converged  # Ry → eV 129	 130	 131	def run_pw(workdir: str, prefix: str) -> tuple[float, bool, float]: 132	    """执行 pw.x → (总能量 eV, 收敛, 耗时秒)。""" 133	    t0 = time.time() 134	    in_file = os.path.join(workdir, f"{prefix}.in") 135	    out_file = os.path.join(workdir, f"{prefix}.out") 136	    env = dict(os.environ) 137	    # MSYS2 的 pw.exe 需要 ucrt64\bin 下的运行时 DLL（libgcc/libgfortran/MPI 等） 138	    env["PATH"] = os.path.dirname(pw_bin()) + os.pathsep + env.get("PATH", "") 139	    with open(out_file, "w", encoding="utf-8") as out: 140	        subprocess.run([pw_bin(), "-in", in_file], stdout=out, stderr=subprocess.STDOUT, check=False, env=env) 141	    wall = time.time() - t0 142	    text = open(out_file, encoding="utf-8", errors="replace").read() 143	    energy, converged = parse_pw_output(text) 144	    if not converged and "!" not in text: 145	        raise RuntimeError(f"pw.x produced no total energy for {prefix}; see {out_file}") 146	    return energy, converged, wall 147	 148	 149	def qe_endorsement(formula: str, delith_frac: float = 0.3) -> dict: 150	    """单个组分周期 DFT 背书：满锂 vc-relax + 去锂 relax + Li 金属参考 → 电压。""" 151	    import tempfile 152	 153	    from bda.simulators.comp_runner import ( 154	        _seed, 155	        average_voltage, 156	        build_doped_structure, 157	        delithiate, 158	    ) 159	 160	    workdir = tempfile.mkdtemp(prefix="bda_qe_") 161	    try: 162	        struct_full, counts, _ = build_doped_structure(formula) 163	        n_li_full = sum(1 for s in struct_full if s.specie.symbol == "Li") 164	        write_inputs(struct_full, workdir, "full", relax_cell=True) 165	        e_full, conv_full, t_full = run_pw(workdir, "full") 166	        struct_delith, n_li_delith = delithiate(struct_full, delith_frac, _seed(formula)) 167	        write_inputs(struct_delith, workdir, "delith", relax_cell=False) 168	        e_delith, conv_delith, t_delith = run_pw(workdir, "delith") 169	        li = Structure(Lattice.cubic(3.51), ["Li", "Li"], [[0, 0, 0], [0.5, 0.5, 0.5]]) 170	        write_inputs(li, workdir, "li", relax_cell=True) 171	        e_li_cell, conv_li, t_li = run_pw(workdir, "li") 172	        e_li = e_li_cell / 2.0 173	        n_removed = n_li_full - n_li_delith 174	        voltage = average_voltage(e_full, e_delith, n_removed, e_li) 175	        return { 176	            "formula": formula, 177	            "realized_tm_counts": counts, 178	            "avg_voltage_v": float(voltage), 179	            "e_full_ev": e_full, 180	            "e_delith_ev": e_delith, 181	            "e_li_metal_ev": e_li, 182	            "converged": bool(conv_full and conv_delith and conv_li), 183	            "wall_time_s": t_full + t_delith + t_li, 184	        } 185	    finally: 186	        shutil.rmtree(workdir, ignore_errors=True) 187	 188	 189	def run_qe_endorsement(in_data: dict) -> dict: 190	    """IN: {"candidates": [{"formula", "name"}]} → OUT: 每候选周期 DFT 背书（含 NMC811 基线）。""" 191	    cands = in_data.get("candidates", []) 192	    if not cands: 193	        raise ValueError("input must contain a non-empty 'candidates' list") 194	    results = [] 195	    for c in cands: 196	        formula = str(c.get("formula") or "") 197	        name = str(c.get("name") or