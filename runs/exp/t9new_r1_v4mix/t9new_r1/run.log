[tool_result]1	"""Composition envelope adjudication for T9-new (layer A): is the candidate's 2	run-comp point outside the pre-registered known-cathode convex hull? 3	 4	Usage: 5	    python comp_envelope_check.py --formula "LiNi0.5Mn0.5O2" 6	    python comp_envelope_check.py --point 4.2 190 -1.5 7	Prints machine-readable JSON verdict (replayable). 8	""" 9	import json 10	import sys 11	from pathlib import Path 12	 13	import numpy as np 14	from scipy.spatial import Delaunay 15	 16	REPO = Path(__file__).resolve().parent 17	ENV = REPO / "runs" / "exp" / "known_set_comp" / "envelope_stats_comp.json" 18	 19	 20	def load() -> tuple[Delaunay, dict]: 21	    env = json.loads(ENV.read_text(encoding="utf-8")) 22	    pts = np.array([[p["V"], p["C"], p["stab"]] for p in env["points"]]) 23	    return Delaunay(pts), env 24	 25	 26	def adjudicate(pt: list[float], name: str = "candidate") -> dict: 27	    tri, env = load() 28	    inside = bool(tri.find_simplex(np.array(pt)) >= 0) 29	    return { 30	        "name": name, 31	        "point": pt, 32	        "in_envelope": inside, 33	        "verdict": "REJECT (known-set analogue)" if inside else "PASS (outside envelope)", 34	        "hull_ref": ENV.name, 35	        "n_known": env["n"], 36	    } 37	 38	 39	def main() -> int: 40	    if len(sys.argv) > 1 and sys.argv[1] == "--point": 41	        pt = [float(x) for x in sys.argv[2:5]] 42	        print(json.dumps(adjudicate(pt), ensure_ascii=False)) 43	        return 0 44	    if len(sys.argv) > 1 and sys.argv[1] == "--formula": 45	        formula = sys.argv[2] 46	        sys.path.insert(0, str(REPO / ".claude" / "skills" / "virtual-battery-factory" / "scripts")) 47	        from bda.simulators.comp_runner import run_composition_screen 48	 49	        out = run_composition_screen({"candidates": [{"name": "candidate", "formula": formula}]}) 50	        c = out["candidates"][0] 51	        if c.get("avg_voltage_v") is None: 52	            print(json.dumps({"error": c.get("error", "no voltage")}, ensure_ascii=False)) 53	            return 1 54	        pt = [c["avg_voltage_v"], c.get("capacity_mah_g", 0), c.get("rel_stability_ev_atom", 0)] 55	        res = adjudicate(pt, formula) 56	        res["computed"] = c 57	        print(json.dumps(res, ensure_ascii=False)) 58	        return 0 59	    print("usage: --formula <f> | --point V C stab") 60	    return 2 61	 62	 63	if __name__ == "__main__": 64	    raise SystemExit(main()) 65
