_SUPERCELL = (2, 2, 1)
_X_FULL, _X_DELITH = 1.0, 0.3  # 满锂 / 去锂态的 Li 占位
_F = 26801.481  # 法拉第常数折算：F/3.6 (mAh·mol⁻¹)

NMC_BASE_FORMULA = "Li(Ni0.8Mn0.1Co0.1)O2"
