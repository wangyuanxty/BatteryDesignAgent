       "converged": bool(conv_full and conv_delith), 234	        "rel_stability_ev_atom": ( 235	            float((e_full / n_atoms) - (base_energy_fu / 4.0)) 236	            if base_energy_fu is not None 237	            else None 238	        ), 239	    } 240	    return out 241	 242	 243	def _li_metal_energy() -> float: 244	    """bcc Li 金属参考能量（每原子 eV，CHGNet 弛豫 2 原子胞）。""" 245	    from pymatgen.core import Lattice as _Lattice 246	 247	    li = Structure(_Lattice.cubic(3.51), ["Li", "Li"], [[0, 0, 0], [0.5, 0.5, 0.5]]) 248	    e, _conv = relax_energy(li) 249	    return e / 2.0 250	 251	 252	def run_composition_screen(in_data: dict) -> dict: 253	    """IN: {"candidates": [{"formula": "...", "name": "..."}]} → OUT: 每候选 metrics + 基线。""" 254	    cands = in_data.get("candidates", []) 255	    if not cands: 256	        raise ValueError("input must contain a non-empty 'candidates' list") 257	    base_e_fu = None 258	    # 基线 NMC811 + bcc Li 金属参考能量 259	    base_struct, _, _ = build_doped_structure(NMC_BASE_FORMULA) 260	    e_base, conv_base = relax_energy(base_struct) 261	    base_e_fu = e_base / _n_fu(NMC_BASE_FORMULA) 262	    e_li = _li_metal_energy() 263	    results = [] 264	    for c in cands: 265	        formula = str(c.get("formula") or "") 266	        name = str(c.get("name") or formula) 267	        try: 268	            m = screen_candidate(formula, base_e_fu, e_li) 269	            m["name"] = name 270	            results.append(m) 271	        except ValueError as exc: 272	            results.append({"name": name, "formula": formula, "error": str(exc)}) 273	    return { 274	        "baseline": { 275	            "formula": NMC_BASE_FORMULA, 276	            "e_full_ev": e_base, 277	            "e_li_metal_ev": e_li, 278	            "converged": bool(conv_base), 279	        }, 280	        "candidates": results, 281	        "calibration_note": ( 282	            "NMC811 基线自校准：文献平均电压 ≈3.8 V、理论容量 ≈194 mAh/g（x∈[0.3,1] 窗口）" 283	            "——若基线预测显著偏离，说明本批结果不可信（如实标注）。" 284	    