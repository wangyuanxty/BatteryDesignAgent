ed by the lumped thermal model, so system candidates 36	# cannot run stage 2/3 without them. Inject standard defaults (constant 37	# approximation of the Chen2020/ORegan2022 cell-level values) only when the chosen 38	# set does not define the parameter itself — mirroring PLATING_PARAM_DEFAULTS. 39	# "Cell volume [m3]" is NOT taken as a constant: it is derived mechanically from 40	# each set's own electrode geometry (see _cell_volume_default). 41	THERMAL_PARAM_DEFAULTS = { 42	    "Cell cooling surface area [m2]": 0.00531, 43	    "Total heat transfer coefficient [W.m-2.K-1]": 10.0, 44	    "Positive current collector conductivity [S.m-1]": 36914000.0, 45	    "Negative current collector conductivity [S.m-1]": 58411000.0, 46	    "Positive current collector thickness [m]": 1.6e-05, 47	    "Negative current collector thickness [m]": 1.2e-05, 48	    "Positive current collector density [kg.m-3]": 2702.0, 49	    "Negative current collector density [kg.m-3]": 8933.0, 50	    "Positive current collector specific heat capacity [J.kg-1.K-1]": 897.0, 51	    "Negative current collector specific heat capacity [J.kg-1.K-1]": 385.0, 52	    # Electrode/separator densities and specific heats feed the lumped model's 53	    # effective heat capacity. These are NMC811/graphite/polyolefin constants from 54	    # ORegan2022 (densities) and Chen2020 (specific heats, 700 J/kg/K); for sets 55	    # with other chemistries (e.g. Prada2013 LFP) they are approximations and the 56	    # run output records them under "injected_defaults". 57	    "Positive electrode density [kg.m-3]": 3699.0, 58	    "Negative electrode density [kg.m-3]": 2060.0, 59	    "Separator density [kg.m-3]": 1548.0, 60	    "Positive electrode specific heat capacity [J.kg-1.K-1]": 700.0, 61	    "Negative electrode specific heat capacity [J.kg-1.K-1]": 700.0, 62	    "Separator specific heat capacity [J.kg-1.K-1]": 700.0, 63	} 64	 65	 66	def _cell_volume_default(parameter_values: pybamm.ParameterValues) -> float | None: 67	    """Mechanical cell volume proxy for sets lacking "Cell volume [m3]": 68	    electrode height x width x (positive + separator + negative layer thickness). 69	    Returns None when any geometric parameter is missing.""" 70	    names = ( 71	        "Electrode height [m]", 72	        "Electrode width [m]", 73	        "Positive electrode thickness [m]", 74	        "Separator thickness [m]", 75	        "Negative electrode thickness [m]", 76	    ) 77	    try: 78	        height, width, l_pos, l_sep, l_neg = (float(parameter_values[n]) for n in names) 79	    except Exception: 80	        return None 81	    return height * width * (l_pos + l_sep + l_neg) 82	 83	 84	def _run_aging(parameter_values: pybamm.ParameterValues, p: dict, mode: str) -> dict: 85	    """老化协议：N 圈 1C 恒流充放（SEI ec reaction limited + isothermal）。 86	 87	    输出 cycle_numbers / capacity_ah_per_cycle / sei_thickness_nm_end。 88	    基参数集无 SEI 动力学参数时报错（老化必须用老化体系，如 Chen2020/OKane2022）。 89	    """ 90	    sei_required = "SEI kinetic rate constant [m.s-1]" 91	    if sei_required not in parameter_values: 92	        raise ValueError( 93	            f"base parameter set has no '{sei_required}'; the aging protocol requires " 94	            "an aging-capable parameter set (e.g. Chen2020, OKane2022)" 95	        ) 96	    v_min = float(parameter_values["Lower voltage cut-off [V]"]) 97	    v_max = float(parameter_values["Upper voltage cut-off [V]"]) 98	    exp = pybamm.Experiment( 99	        [( 100	            f"Discharge at {p['C_rate']:g}C until {v_min} V", 101	            f"Charge at {p['C_rate']:g}C until {v_max} V", 102	        )] * p["cycles"] 103	    ) 104	    options = {"SEI": "ec reaction limited", "thermal": "isothermal"} 105	    model = ( 106	        pybamm.lithium_ion.DFN(options=options) 107	        if mode == "dfn" 108	        else pybamm.lithium_ion.SPMe(options=options) 109	    ) 110	    sol = pybamm.Simulation(model, experiment=exp, parameter_values=parameter_values).solve() 111	    caps = [ 112	        float(sol.cy