[tool_result]1	"""calc-energy：合同口径能量密度计算（所有任务共用同一公式，杜绝跨任务抄先例）。 2	 3	ED = ∫V·I_1C dt / Σ(层厚×(1−孔隙率)×密度×面积) 4	- I_1C = Nominal cell capacity × 1（恒流） 5	- 面积 = Electrode height × width 6	- 层：正/负极活性层（含孔隙）、正/负集流体（无孔隙因子）、隔膜 7	- 电解液不计入质量（参数集缺密度，如实标注） 8	""" 9	import json 10	from pathlib import Path 11	 12	import numpy as np 13	import pybamm 14	 15	 16	def _layer(th: float, por: float, den: float) -> float: 17	    return th * (1 - por) * den  # kg/m² 18	 19	 20	def calc_energy(params_json: str, discharge_json: str, base: str) -> dict: 21	    if base.endswith(".json"): 22	        # 自定义参数集（高电压 LNMO 等）：Chen2020 基底 + JSON 覆盖键（OCP 符号函数手动绑定） 23	        import json as _json 24	        from pathlib import Path as _Path 25	 26	        from bda.simulators.lnmo_parameters import lnmo_ocp 27	 28	        extra = _json.loads(_Path(base).read_text(encoding="utf-8")) 29	        for key in ("Positive electrode OCP [V]", "Positive electrode OCP [V] (from stoich)"): 30	            if isinstance(extra.get(key), str): 31	                extra[key] = lnmo_ocp 32	        pv = pybamm.ParameterValues("Chen2020") 33	        pv.update(extra, check_already_exists=False) 34	    else: 35	        pv = pybamm.ParameterValues(base) 36	    if params_json: 37	        ov = json.loads(Path(params_json).read_text(encoding="utf-8-sig")) 38	        pv.update(ov) 39	    area = float(pv["Electrode height [m]"]) * float(pv["Electrode width [m]"]) 40	    i_1c = float(pv["Nominal cell capacity [A.h]"]) * 1.0 41	    dis = json.loads(Path(discharge_json).read_text(encoding="utf-8-sig")) 42	    v = np.asarray(dis["voltage_v"]) 43	    t = np.asarray(dis["time_s"]) 44	    # 兼容 numpy 2（np.trapezoid）与 1.x（np.trapz 旧名） 45	    _trapz = getattr(np, "trapezoid", np.trapz) 46	    energy_wh = float(_trapz(v * i_1c, t) / 3600.0) 47	    pos_el = _layer( 48	        float(pv["Positive electrode thickness [m]"]), 49	        float(pv["Positive electrode porosity"]), 50	        float(pv["Positive electrode density [kg.m-3]"]), 51	    ) 52	