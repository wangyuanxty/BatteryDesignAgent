h = work / "progress.jsonl" 116	    done: dict[str, dict[str, Any]] = {} 117	    if prog_path.exists(): 118	        for line in prog_path.read_text(encoding="utf-8").splitlines(): 119	            if line.strip(): 120	                r = json.loads(line) 121	                done[r["name"]] = r 122	 123	    if args.smoke: 124	        entries = entries[: args.smoke] 125	    print(f"known additives: {len(entries)} (fresh={sum(1 for e in entries if e['name'] not in done)})", 126	          flush=True) 127	 128	    for i, e in enumerate(entries, 1): 129	        name, smiles = e["name"], e["smiles"] 130	        if name in done and not args.smoke: 131	            continue 132	        t0 = time.time() 133	        rec: dict[str, Any] = {"name": name, "smiles": smiles} 134	        try: 135	            rec["mace"] = relax_ml(smiles, "mace") 136	        except Exception as ex:  # noqa: BLE001 - batch must not die on one molecule 137	            rec["mace"] = {"error": f"{type(ex).__name__}: {str(ex)[:200]}"} 138	        try: 139	            rec["chgnet"] = relax_ml(smiles, "chgnet") 140	        except Exception as ex:  # noqa: BLE001 141	            rec["chgnet"] = {"error": f"{type(ex).__name__}: {str(ex)[:200]}"} 142	        try: 143	            rec["xtb"] = xtb_run(smiles) 144	        except Exception as ex:  # noqa: BLE001 145	            rec["xtb"] = {"error": f"{type(ex).__name__}: {str(ex)[:200]}"} 146	        rec["elapsed_s"] = round(time.time() - t0, 1) 147	        with prog_path.open("a", encoding="utf-8") as fh: 148	            fh.write(json.dumps(rec, ensure_ascii=False) + "\n") 149	        ok = all(isinstance(rec[k], dict) and "error" not in rec[k] for k in ("mace", "chgnet", "xtb")) 150	        print(f"[{i}/{len(entries)}] {name}: {'OK' if ok else 'ERRORS'} " 151	              f"(mace={rec['mace'].get('energy_ev', '?')}, " 152	              f"chgnet={rec['chgnet'].get('energy_ev', '?')}, " 153	              f"xtb-homo={rec['xtb'].get('homo_ev', '?')}, {rec['elapsed_s']}s)", flush=True) 154	 155	    prog = [ 156	        json.loads(l) 157	        for l in prog_path.read_text(encoding="utf-8").splitlines() 158	        if l.strip() 159	    ] if prog_path.exists() else [] 160	    complete = [p for p in prog if all(isinstance(p.get(k), dict) and "error" not in p[k] 161	                                       for k in ("mace", "chgnet", "xtb"))] 162	    (work / "mace_out.json").write_text( 163	        json.dumps(deliverable_schema("mace", complete), indent=2), encoding="utf-8") 164	    (work / "chgnet_out.json").write_text( 165	        json.dumps(deliverable_schema("chgnet", complete), indent=2), encoding="utf-8") 166	    (work / "xtb_out.json").write_text( 167	        json.dumps(deliverable_schema("xtb", complete), indent=2), encoding="utf-8") 168	    print(f"DONE: {len(complete)}/{len(prog)} complete; elapsed total via progress.jsonl", flush=True) 169	    return 0 170	 171	 172	if __name__ == "__main__": 173	    raise SystemExit(main()) 174
