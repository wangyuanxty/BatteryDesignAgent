    parts.append(f'<font color=\"#C97B3D\">{_esc(seg)}</font>')\n        else:\n            parts.append(_esc(seg))\n    return \"\".join(parts)\n\ndef _esc(s):\n    return s.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n\ndef md_to_pdf(md_path, pdf_path):\n    lines = open(md_path, encoding=\"utf-8\").read().splitlines()\n    doc = SimpleDocTemplate(pdf_path, pagesize=A4,\n                            leftMargin=M, rightMargin=M,\n                            topMargin=1.2 * cm, bottomMargin=1.2 * cm,\n                            title=md_path.split(\"/\")[-1])\n    story = []\n    i = 0\n    while i < len(lines):\n        raw = lines[i]\n        s = raw.strip()\n        if not s or s == \"---\":\n            i += 1\n            continue\n        if s.startswith(\"# \"):\n            story.append(Paragraph(inline(s[2:]), S_TITLE))\n        elif s.startswith(\"## \"):\n            story.append(Paragraph(inline(s[3:]), S_H2))\n        elif s.startswith(\"### \"):\n            story.append(Paragraph(inline(s[4:]), S_H3))\n        elif s.startswith(\"|\"):\n            header = [c.strip() for c in s.strip(\"|\").split(\"|\")]\n            rows = []\n            j = i + 1\n            while j < len(lines) and lines[j].strip().startswith(\"|\"):\n                t = lines[j].strip()\n                if re.match(r\"^\\|[\\s:\\-|]+\\|?$\", t):\n                    j += 1\n                    continue\n                rows.append([c.strip() for c in t.strip(\"|\").split(\"|\")])\n                j += 1\n            i = j - 1\n            if not rows:\n                i += 1\n                continue\n            ncols = len(header)\n            data = [[Paragraph(_esc(c), S_CELLH) for c in header[:ncols]]]\n            for r in rows:\n                data.append([Paragraph(inline(c), S_CELL) for c in (r + [\"\"] * ncols)[:ncols]])\n            col_w = USABLE / ncols\n            tbl = Table(data, colWidths=[col_w] * ncols, repeatRows=1)\n            tbl.setStyle(TableStyle([\n                (\"BACKGROUND\", (0, 0), (-1, 0), DEEP),\n                (\"ROWBACKGROUNDS\", (0, 1), (-1, -1), [colors.white, LIGHT_BG]),\n                (\"GRID\", (0, 0), (-1, -1), 0.4, colors.HexColor(\"#B9C6D3\")),\n                (\"VALIGN\", (0, 0), (-1, -1), \"TOP\"),\n                (\"LEFTPADDING\", (0, 0), (-1, -1), 4),\n                (\"RIGHTPADDING\", (0, 0), (-1, -1), 4),\n                (\"TOPPADDING\", (0, 0), (-1, -1), 3),\n                (\"BOTTOMPADDING\", (0, 0), (-1, -1), 3),\n            ]))\n            story.append(tbl)\n            story.append(Spacer(1, 8))\n        elif s.startswith(\"- \"):\n            story.append(Paragraph(\"• \" + inline(s[2:]), S_P))\n        elif re.match(r\"^\\d+\\.\\s\", s):\n            story.append(Paragraph(inline(s), S_P))\n        else:\n            story.append(Paragraph(inline(s), S_P))\n        i += 1\n    doc.build(story)\n    print(\"pdf:\", pdf_path)\n\ndef xlsx_to_pdf(xlsx_path, pdf_path):\n    wb = openpyxl.load_workbook(xlsx_path, data_only=True)\n    doc = SimpleDocTemplate(pdf_path, pagesize=A4,\n                            leftMargin=M, rightMargin=M,\n                            topMargin=1.2 * cm, bottomMargin=1.2 * cm,\n                            title=xlsx_path.split(\"/\")[-1])\n    story = []\n    first_sheet = True\n    for ws in wb.worksheets:\n        if not first_sheet:\n            story.append(PageBreak())\n        first_sheet = False\n        story.append(Paragraph(_esc(f\"{ws.title} — {xlsx_path.split('/')[-1].split('.')[0]}\"),\n                               S_H2))\n        grid = []\n        for row in ws.iter_rows(values_only=True):\n            if all(v is None or str(v).strip() == \"\" for v in row):\n                continue\n            grid.append([str(v) if v is not None else \"\" for v in row])\n        if not grid:\n            continue\n        ncols = max(len(r) for r in grid)\n        grid = [r + [\"\"] * (ncols - len(r)) for r in grid]\n        # column widths: content-length proportional, capped\n        lens = [max(len(r[c]) for r in grid) for c in range(ncols)]\n        total_len = max(sum(lens), 1)\n        col_w = [max(38.0, min(190.0, USABLE * l / total_len)) for l in lens]\n        scale = USABLE / sum(col_w)\n        col_w = [w * scale for w in col_w]\n        data = [[Paragraph(_esc(c), S_CELLH) for c in grid[0]]]\n        for r in grid[1:]:\n            data.append([Paragraph(_esc(c), S_CELL) for c in r])\n        tbl = Table(data, colWidths=col_w, repeatRows=1)\n        tbl.setStyle(TableStyle([\n            (\"BACKGROUND\", (0, 0), (-1, 0), DEEP),\n            (\"ROWBACKGROUNDS\", (0, 1), (-1, -1), [colors.white, LIGHT_BG]),\n            (\"GRID\", (0, 0), (-1, -1), 0.4, colors.HexColor(\"#B9C6D3\")),\n            (\"VALIGN\", (0, 0), (-1, -1), \"TOP\"),\n            (\"LEFTPADDING\", (0, 0), (-1, -1), 4),\n            (\"RIGHTPADDING\", (0, 0), (-1, -1), 4),\n            (\"TOPPADDING\", (0, 0), (-1, -1), 3),\n            (\"BOTTOMPADDING\", (0, 0), (-1, -1), 3),\n        ]))\n        story.append(tbl)\n        story.append(Spacer(1, 10))\n    doc.build(story)\n    print(\"pdf:\", pdf_path)\n\nD = \"runs/exp/t1_r2/deliverables\"\nfor name in [\"design_spec\", \"datasheet\", \"dvpr\", \"dfmea\", \"delivery_index\"]:\n    md_to_pdf(f\"{D}/{name}.md\", f\"{D}/{name}.pdf\")\nfor name in [\"bom\", \"calc\"]:\n    xlsx_to_pdf(f\"{D}/{name}.xlsx\", f\"{D}/{name}.pdf\")\nprint(\"done\")\n"}
