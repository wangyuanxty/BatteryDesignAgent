or (Al)\", 2.21832, \"layer_kg_m2.positive_cc x 0.1027 m2 (8 um x 2700 kg/m3)\"),\n    (\"Negative current collector (Cu)\", 5.52115, \"layer_kg_m2.negative_cc x 0.1027 m2 (6 um x 8960 kg/m3)\"),\n    (\"Electrolyte (LiPF6/EC-EMC)\", 7.694, \"pore volume 6.41 cm3 x 1.2 g/cm3 literature density (annotated estimate), fill factor 1.0\"),\n    (\"Enclosure / tabs\", None, \"Not modeled (beyond pure simulation boundary)\"),\n]\nfor name, mass, src in rows:\n    if mass is None:\n        ws.append([name, \"Not modeled\", \"Not modeled\", src])\n    else:\n        ws.append([name, round(mass, 3), round(mass / KWH / 1000.0, 4), src])\n\ntot_noel = 35.2409\ntot_el = tot_noel + 7.694\nws.append([])\nws.append([\"Total (contract caliber, electrolyte excluded)\", round(tot_noel, 3), round(tot_noel / KWH / 1000.0, 4), \"= cell/r4_v4b_energy.json:mass_kg x 1000\"])\nws.append([\"Total (incl. electrolyte estimate)\", round(tot_el, 3), round(tot_el / KWH / 1000.0, 4), \"= subtotal + electrolyte\"])\nfor r in (18, 19):\n    for c in range(1, 5):\n        ws.cell(row=r, column=c).fill = SEC_FILL\n        ws.cell(row=r, column=c).font = SEC_FONT\nws.column_dimensions[\"A\"].width = 42\nws.column_dimensions[\"B\"].width = 16\nws.column_dimensions[\"C\"].width = 16\nws.column_dimensions[\"D\"].width = 95\nwb.save(f\"{DEL}/bom.xlsx\")\nprint(\"bom.xlsx saved\")\n\n# ---------------- CALC ----------------\nwb2 = Workbook()\n\nws = wb2.active\nws.title = \"Inputs\"\nws.append([\"Design Calculation Sheet - V4b (VBF-T1R2-CALC-01) | case t1_r2\"])\nws.append([\"Parameter\", \"Base (Chen2020)\", \"V4b design value\", \"Unit\", \"Source\"])\nstyle_header(ws, 2, 5)\ninputs = [\n    (\"Positive electrode thickness\", 75.6, 75.6, \"um\", \"parameter set (base, unchanged)\"),\n    (\"Negative electrode thickness\", 85.2, 96.0, \"um\", \"cell/params_v4b.json\"),\n    (\"Separator thickness\", 12.0, 9.0, \"um\", \"cell/params_v4b.json\"),\n    (\"Positive current collector thickness\", 16.0, 8.0, \"u