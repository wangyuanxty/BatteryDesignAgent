te` 内部键携带证据来源标注（两者都不进条目 metrics）。 58	    """ 59	    metrics: dict[str, tuple] = {} 60	    potentials: dict[Path, list] = {} 61	    for f in files: 62	        data = json.loads(f.read_text(encoding="utf-8-sig")) 63	        if not isinstance(data, dict): 64	            continue 65	        for k, v in data.items(): 66	            if isinstance(v, (int, float, bool)): 67	                metrics[k] = (v, f) 68	            elif k == "anode_potential_v" and isinstance(v, list) and v: 69	                potentials[f] = v 70	    if "plated" not in metrics and potentials: 71	        f, v = max(potentials.items(), key=lambda kv: len(kv[1]))  # 最完整时序 72	        mn = min(v) 73	        metrics["plated"] = (mn < 0.0, f) 74	        metrics["_plated_note"] = ( 75	            f"anode_potential_v (min={mn:.4g}V{'<' if mn < 0 else '>'}0 推导)", 76	            f, 77	        ) 78	    return metrics 79	 80	 81	def _rel_to(path: Path, base: Path) -> str: 82	    """来源路径相对化：在 base 下 → 相对 posix 串；否则回退绝对路径。""" 83	    try: 84	        return path.relative_to(base).as_posix() 85	    except ValueError: 86	        return path.as_posix() 87	 88	 89	def _threshold_ok(value, threshold) -> bool: 90	    """阈值三形态：{"min": n} / {"max": n} / 布尔等值 / 标量数值（视为 min）。""" 91	    if isinstance(threshold, dict): 92	        lo = threshold.get("min") 93	        hi = threshold.get("max") 94	        if lo is not None or hi is not None: 95	            # 有数值边界但 value 不可比（str/list）→ 不过；无任何边界 → 视为未限定通过 96	            if not isinstance(value, (int, float)): 97	                return False 98	            if isinstance(lo, (int, float)) and value < lo: 99	                return False 100	            if isinstance(hi, (int, float)) and value > hi: 101	                return False 102	        return True 103	    if isinstance(threshold, bool): 104	        return bool(value) == threshold 105	    if isinstance(threshold, (int, float)) and isinstance(value, (int, float)): 106	        return value >= threshold 107	    return False  # 无法判定的形态一律不过（宁可 fail 不可假 pass） 108	 109	 110	def check_against_criteria(metrics: dict[str, tuple], thresholds: dict, base: Path) -> tuple[list, list]: 111	    """→ (evidence 列表, unchecked 键列表)。evidence 指向文件:键，判定结果由代码给出。 112	 113	    base = case 目录：来源路径相对化（审计日志跨机器可重放，不嵌绝对路径）。 114	    """ 115	    evidence: list[dict] = [] 116	    unchecked: list[str] = [] 117	    for key, threshold in thresholds.items(): 118	        if key not in metrics: 119	            unchecked.append(key) 120	            continue 121	        value, src = metrics[key] 122	        source = f"{_rel_to(src, base)}:{key}" 123	        if key == "plated" and "_plated_note" in metrics: 124	            note, _ = metrics["_plated_note"] 125	            source = f"{_rel_to(src, base)}:{note}" 126	        ok = _threshold_ok(value, threshold) 127	        evidence.append( 128	            { 129	                "metric": key, 130	                "value": value, 131	                "threshold": threshold, 132	                "verdict": "pass" if ok else "fail", 133	                "source": source, 134	            } 135	        ) 136	    return evidence, unchecked 137	 138	 139	def _evaluate_one(case_dir: Path, records: list, candidate: str, outputs: list[str], note: str) -> dict: 140	    """单个候选评估（内部共用）：读输出文件 → 机械判定 → 返回条目（不落盘）。""" 141	    thresholds = None  # 每候选共享同轮 criteria，由调用方传入（见 _evaluate_record） 142	 143	    files: list[Path] = [] 144	    for arg in outputs: 145	        p = None 146	        for cand in (case_dir / arg, REPO_ROOT / arg, Path(arg)): 147	            if cand.exists() and cand.is_file(): 148	                p = cand 149	                break 150	        if p is None: 151	            raise RuntimeError(f"输出文件不存在：{arg}") 152	        files.append(p) 153	    if not files: 154	        raise RuntimeError("无有效输出文件") 155	    metrics = extract_metrics(files) 156	    evidence, unchecked = check_against_criteria(metrics, dict(records), base=case_dir) 157	    if not evidence: 158	        raise RuntimeError("输出文件中没有任何 criteria 指标（metrics 为空或键不匹配）") 159	    verdict = "pass" if all(ev["verdict"] == "pass" for ev in evidence) else "fail" 160	    note_raw = note or "" 161	    if unchecked: 162	        note_raw = (note_raw + "｜" if note_raw else "") + "未检查 criteria: " + ", ".join(unchecked) 163	    entry = { 164	        "action": "evaluate", 165	        "metrics": { 166	            k: v 167	            for k, (v, _) in metrics.items() 168	            if not k.startswith("_") and isinstance(v, (int, float, bool)) 169	        }, 170	        "verdict": verdict, 171	        "evidence": evidence, 172	        "note": note_raw, 173	    } 174	    if candidate: 175	        entry["candidate"] = candidate 176	    if unchecked: 177	        entry["unchecked"] = unchecked 178	    return entry 179	 180	 181	def cmd_log_evaluate(args) -> int: 182	    case_dir = Path(args.case_dir) 183	    if not case_dir.is_absolute(): 184	        case_dir = REPO_ROOT / case_dir 185	    ws = CaseWorkspace(case_dir.name, str(case_dir.parent), create=False) 186	    criteria = load_criteria(ws) 187	    thresholds = flatten_criteria(criteria) 188	 189	    if getattr(args, "batch_file", None): 190	        # 批量模式：一次评估多个候选，每个候选逐条落 evaluate 条目（机械判定） 191	        import json as _json 192	 193	        batch = _json.loads(Path(args.batch_file).read_text(encoding="utf-8-sig")) 194	        if not isinstance(batch, list) or not batch: 195	            raise RuntimeError("--batch-file 必须是非空列表 [{'candidate': 'V1', 'outputs': [...], 'note': ...}]") 196	        for rec in batch: 197	            if "outputs" not in rec: 198	                raise RuntimeError(f"batch 记录缺 outputs 键: {rec}") 199	            rec_round = rec.get("round", args.round) 200	            entry = _evaluate_one(case_dir, thresholds, rec.get("candidate", ""), rec["outputs"], rec.get("note", "")) 201	            entry["round"] = rec_round 202	            append_entry(ws, entry) 203	            print( 204	                f"log-evaluate 已记录: round={rec_round}