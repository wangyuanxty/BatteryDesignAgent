[tool_result]1	"""log-evaluate：评估条目确定性写入（判定由代码完成，agent 只传候选与输出文件）。 2	 3	背景：agent 在对话里评估候选（读仿真输出、口头下结论）不会自动落日志—— 4	t1_r1_v3 实测 V1-V3 评估只存在于散文引用、审计链无条目。本命令把 5	"评估发生 → 条目存在"变成机械保证： 6	 7	- criteria 取自 log.jsonl 第 0 条（开跑前预注册的阈值） 8	- metrics 从仿真输出 JSON 文件机械提取（plated 由 anode_potential_v 推导） 9	- verdict 由代码对照阈值判定（min/max 数值 / 布尔等值），agent 不得手写 10	- evidence 指向实际文件路径与键，数值永远有来源（杜绝幻觉数值） 11	 12	verdict 规则：被检查的 criteria 非空且全部通过 → pass，否则 fail； 13	输出文件缺某 criteria 指标 → 记入 entry.unchecked 并在 note 追加说明 14	（阶段未到的指标属于合法缺失——材料轮评估不测 T_max，由最终 15	endorse/final 的"无证据不许结案"兜底全 criteria 覆盖）。 16	""" 17	import json 18	import sys 19	from pathlib import Path 20	 21	from bda.store import CaseWorkspace, REPO_ROOT, append_entry 22	 23	_STAGE_KEYS = ("stage1", "stage2", "stage3")  # meta 不参与判定 24	 25	 26	def load_criteria(ws: CaseWorkspace) -> dict: 27	    """log.jsonl 第 0 条 criteria（开跑前预注册）；缺失即错误。""" 28	    log_path = ws.path / "log.jsonl" 29	    if not log_path.exists(): 30	        raise RuntimeError(f"log.jsonl 不存在：{log_path}（先写 criteria 第 0 条再评估）") 31	    for line in log_path.read_text(encoding="utf-8-sig").splitlines(): 32	        line = line.strip() 33	        if not line: 34	            continue 35	        entry = json.loads(line) 36	        if isinstance(entry.get("criteria"), dict): 37	            return entry["criteria"] 38	    raise RuntimeError("log.jsonl 第 0 条 criteria 未找到（评估判定需要预注册阈值）") 39	 40	 41	def flatten_criteria(criteria: dict) -> dict: 42	    """stage1–3 合并为扁平 {指标键: 阈值}（meta 不参与判定）。""" 43	    flat: dict = {} 44	    for k in _STAGE_KEYS: 45	        v = criteria.get(k) 46	        if isinstance(v, dict): 47	            flat.update(v) 48	    return flat 49	 50	 51	def extract_metrics(files: list[Path]) -> dict[str, tuple]: 52	    """仿真输出 JSON → {指标键: (值, 来源文件)}，后文件覆盖前文件（last-wins）。 53	 54	    标量（int/float/bool）直接提取；`anode_potential_v` 列表保留给 plated 推导： 55	    criteria 常含 `plated: false`（要求无析锂）而输出无该键 → 由电压时序 56	    min < 0 机械推导（v3 人工条目同样口径）。推导结果以 `plated` 键进入 57	    metrics，`_plated_no