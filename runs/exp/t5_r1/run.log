ameter_values["Lower voltage cut-off [V]"]) 199	        v_max = float(parameter_values["Upper voltage cut-off [V]"]) 200	        if p["kind"] in ("charge", "overcharge"): 201	            # 过充协议：充电截止 = 上限 + cutoff_add_v（默认 +0.5 V） 202	            v_cut = v_max + p.get("cutoff_add_v", 0.0) 203	            exp = pybamm.Experiment( 204	                [ 205	                    f"Discharge at 1C until {v_min} V", 206	                    f"Charge at {p['C_rate']:g}C until {v_cut:g} V", 207	                ] 208	            ) 209	        else: 210	            exp = pybamm.Experiment([f"Discharge at {p['C_rate']:g}C until {v_min} V"]) 211	        sim = pybamm.Simulation(model, experiment=exp, parameter_values=parameter_values) 212	        sim.solve() 213	        return sim.solution 214	 215	    model_used = "DFN" if mode == "dfn" else "SPMe" 216	    try: 217	        sol = _solve( 218	            pybamm.lithium_ion.DFN(options=options) 219	            if mode == "dfn" 220	            else pybamm.lithium_ion.SPMe(options=options) 221	        ) 222	    except pybamm.SolverError: 223	        if mode == "dfn" and fallback: 224	            sol = _solve(pybamm.lithium_ion.SPMe(options=options)) 225	            model_used = "SPMe(fallback)" 226	        else: 227	            raise 228	 229	    out = { 230	        "model_used": model_used, 231	        "time_s": sol["Time [s]"].entries.tolist(), 232	        "voltage_v": sol["Terminal voltage [V]"].entries.tolist(), 233	    } 234	    if injected_defaults: 235	        # Audit trail: which standard defaults the runner injected for this run 236	        # (legacy parameter sets lacking lumped-thermal geometry/collector params). 237	        out["injected_defaults"] = injected_defaults 238	    if p["kind"] == "discharge": 239	        out["capacity_ah"] = float(sol.cycles[-1]["Discharge capacity [A.h]"].entries[-1]) 240	    else: 241	        # 充电容量 = 最后一段（充电段）时长 × C_rate（恒流） 242	        cyc = sol.cycles[-1] 243	        t_cyc = cyc["Time [s]"]