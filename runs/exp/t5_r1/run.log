chanical cell volume proxy for sets lacking "Cell volume [m3]": 68	    electrode height x width x (positive + separator + negative layer thickness). 69	    Returns None when any geometric parameter is missing.""" 70	    names = ( 71	        "Electrode height [m]", 72	        "Electrode width [m]", 73	        "Positive electrode thickness [m]", 74	        "Separator thickness [m]", 75	        "Negative electrode thickness [m]", 76	    ) 77	    try: 78	        height, width, l_pos, l_sep, l_neg = (float(parameter_values[n]) for n in names) 79	    except Exception: 80	        return None 81	    return height * width * (l_pos + l_sep + l_neg) 82	 83	 84	def _run_aging(parameter_values: pybamm.ParameterValues, p: dict, mode: str) -> dict: 85	    """老化协议：N 圈 1C 恒流充放（SEI ec reaction limited + isothermal）。 86	 87	    输出 cycle_numbers / capacity_ah_per_cycle / sei_thickness_nm_end。 88	    基参数集无 SEI 动力学参数时报错（老化必须用老化体系，如 Chen2020/OKane2022）。 89	    """ 90	    sei_required = "SEI kinetic rate constant [m.s-1]" 91	    if sei_required not in parameter_values: 92	        raise ValueError( 93	            f"base parameter set has no '{sei_required}'; the aging protocol requires " 94	            "an aging-capable parameter set (e.g. Chen2020, OKane2022)" 95	        ) 96	    v_min = float(parameter_values["Lower voltage cut-off [V]"]) 97	    v_max = float(parameter_values["Upper voltage cut-off [V]"]) 98	    exp = pybamm.Experiment( 99	        [( 100	            f"Discharge at {p['C_rate']:g}C until {v_min} V", 101	            f"Charge at {p['C_rate']:g}C until {v_max} V", 102	        )] * p["cycles"] 103	    ) 104	    options = {"SEI": "ec reaction limited", "thermal": "isothermal"} 105	    model = ( 106	        pybamm.lithium_ion.DFN(options=options) 107	        if mode == "dfn" 108	        else pybamm.lithium_ion.SPMe(options=options) 109	    ) 110	    sol = pybamm.Simulation(model, experiment=exp, parameter_values=parameter_values).solve() 111	    caps = [ 112	        float(sol.cy