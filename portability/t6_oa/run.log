from pathlib import Path


def _repo_root() -> Path:
    """仓库根 = 含 .git 或 .claude 的最上层目录（相对路径一律基于它解析，杜绝 cwd 依赖）。"""
    p = Path(__file__).resolve()
    for parent in p.parents:
        if (parent / ".git").exists() or (parent / ".claude").exists():
            return parent
    return p.parents[3]


REPO_ROOT = _repo_root()


